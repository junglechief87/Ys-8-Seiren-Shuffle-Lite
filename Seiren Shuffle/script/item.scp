function "it_receive_items"
{
	SetFlag( TF_MENU_SELECT2, 0 )
	YesNoMenu(TF_MENU_SELECT2,"�@�@�@Receive #2CAP Items#0C that cannot be obtained automatically",1)
	
	if(FLAG[TF_MENU_SELECT2])
	{
		if(!FLAG[SF_BOSS_BATTLE] &&  && !FLAG[SF_RETRY])
		{
			if(FLAG[GF_TBOX_DUMMY071] && !FLAG[GF_TBOX_DUMMY109] && ALLITEMWORK[ICON3D_WP_ADOL_008] < 1) 
			{
				SetFlag(GF_ADOLWEAPON_BACKUP,(ADOL.CHRWORK[CWK_WEAPON]))
				GetItem(ICON3D_WP_ADOL_008,1)
				EquipWeapon(ADOL,ICON3D_WP_ADOL_008)
				Message("#4CMistilteinn Received")
				WaitPrompt()
				WaitCloseWindow()
			}
			if(FLAG[GF_TBOX_DUMMY108] && !FLAG[GF_TBOX_DUMMY109] && ALLITEMWORK[ICON3D_WP_DANA_005] < 1)
			{
				GetItem(ICON3D_WP_DANA_005,1)
				EquipWeapon(DANA,ICON3D_WP_DANA_005)
				Message("#4CSpirit Ring Celesdia Received")
				WaitPrompt()
				WaitCloseWindow()
			}
			if(FLAG[SF_ADOL_JOINED] && !FLAG[SF_ADOL_JOINOK])
			{
				SetFlag(SF_ADOL_JOINOK, 1)
        		JoinParty(PARTY_ADOL)
				Message("#4CAdol Received")
				WaitPrompt()
				WaitCloseWindow()
				CallFunc("rng:0520")
        		CallFunc("rng:0521")
			}
			if(FLAG[SF_LAXIA_JOINED] && !FLAG[SF_LAXIA_JOINOK])
			{
				SetFlag(SF_LAXIA_JOINOK, 1)
        		JoinParty(PARTY_LAXIA)
				SetDiaryFlag( DF_JOIN_LAXIA, 1 )
				Message("#4CLaxia Received")
				WaitPrompt()
				WaitCloseWindow()
				CallFunc("rng:0522")
        		CallFunc("rng:0523")
			}
			if(FLAG[SF_SAHAD_JOINED] && !FLAG[SF_SAHAD_JOINOK])
			{
				etFlag(SF_SAHAD_JOINOK, 1)
        		JoinParty(PARTY_SAHAD)
				SetDiaryFlag( DF_JOIN_SAHAD, 1 )
				Message("#4CSahad Received")
				WaitPrompt()
				WaitCloseWindow()
				CallFunc("rng:0524")
        		CallFunc("rng:0525")
			}
			if(FLAG[SF_HUMMEL_JOINED] && !FLAG[SF_HUMMEL_JOINOK])
			{
				SetFlag(SF_HUMMEL_JOINOK, 1)
        		JoinParty(PARTY_HUMMEL)
				SetDiaryFlag( DF_JOIN_HUMMEL, 1 )
				Message("#4CHummel Received")
				WaitPrompt()
				WaitCloseWindow()
				CallFunc("rng:0526")
        		CallFunc("rng:0527")
			}
			if(FLAG[SF_RICOTTA_JOINED] && !FLAG[SF_RICOTTA_JOINOK])
			{
				SetFlag(SF_RICOTTA_JOINOK, 1)
        		JoinParty(PARTY_RICOTTA)
				SetDiaryFlag( DF_JOIN_RICOTTA, 1 )
    			SetFlag( GF_QUEST_400, QUEST_START )
    			SetDiaryFlag( DF_QS400_START, 1 )
				Message("#4CRicotta Received")
				WaitPrompt()
				WaitCloseWindow()
				CallFunc("rng:0528")
        		CallFunc("rng:0529")
			}
			if(FLAG[SF_DANA_JOINED] && !FLAG[SF_DANA_JOINOK])
			{
				SetFlag(SF_DANA_JOINOK, 1)
    			SetDiaryFlag( DF_JOIN_DANA, 1 )
    			JoinParty(PARTY_DANA)
				Message("#4CDana Received")
				WaitPrompt()
				WaitCloseWindow()
				CallFunc("rng:0530")
        		CallFunc("rng:0531")
			}
		}
		else
		{
			Message("Can't receive items right now.")
			WaitPrompt()
			WaitCloseWindow()
		}
	}

	
}
