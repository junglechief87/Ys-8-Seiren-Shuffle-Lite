function "it_pt1"
{
	SetFlag(TF_MENU_SELECT2, 1)
	if (this.CHRWORK[CWK_MAXHP] <= this.CHRWORK[CWK_HP])
	{
		PlaySE( SE_CAMPMENU , 100 , 0,  0, 0, 1.0f, 0)
		YesNoMenu(TF_MENU_SELECT2,"�g�o���񕜂���K�v������܂��񂪁A�g�p���܂����H",0)
	}

	if( FLAG[TF_MENU_SELECT2] )
	{
		// �g���Ă���
		// �|�[�V�����P�iHP 60% �񕜁j
		HP_Heal( this , (this.CHRWORK[CWK_MAXHP] * 0.6f))
		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

		if (this.CHRWORK[CWK_CHRID] == ADOL)
		{
			PlayVoice(Y8V_0037,"ADOL",100)			//�܂��܂��s����I
		}
		else if (this.CHRWORK[CWK_CHRID] == LAXIA)
		{
			PlayVoice(Y8V_0237,"LAXIA",100)			// �܂��܂��s���܂��I
		}
		else if (this.CHRWORK[CWK_CHRID] == SAHAD)
		{
			PlayVoice(Y8V_1281,"SAHAD",100)			// �����A�K���K���s�����I
		}
		else if (this.CHRWORK[CWK_CHRID] == HUMMEL)
		{
			PlayVoice(Y8V_2043,"HUMMEL",100)		// �������炪�{�Ԃ��I
		}
		else if (this.CHRWORK[CWK_CHRID] == RICOTTA)
		{
			PlayVoice(Y8V_2426,"RICOTTA",100)		// �Ȃ͂́A�������I
		}
		else if (this.CHRWORK[CWK_CHRID] == DANA)
		{
			PlayVoice(Y8V_2864,"DANA",100)			// �܂��܂��s�����I
		}

		// �����
		UseItem(ICON3D_US_HEALSOLO_01, 1)

		if(!FLAG[SF_INFERNO])	//INFERNO�ł͋󂫕r�c��Ȃ�
		{
			Wait(5)
			GetItem(ICON3D_EV_EMPTY_BOTTLE,1)
			GetItemMessageExPlus( ICON3D_EV_EMPTY_BOTTLE, 1 , ITEMMSG_SE_BETTER , "���c�����B" , 0 , 0 )
			WaitPrompt()
			WaitCloseWindow()
		}
	}
	else
	{
		// �g�����Ⴞ��	// ���������߂�
		SetCantUseItem(ICON3D_US_HEALSOLO_01)
//		PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}
}

