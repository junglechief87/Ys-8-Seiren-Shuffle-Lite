function "NightHunt_Stopper"
{

//�J�n������������----------------------------------------------------
	// PLAYER2��PLAYER3�̂ǂ��炩��PLAYER1�����苗������Ă�����
	// PLAYER1�̂��΂Ƀ��[�v����
	SetFlag( TF_CHECK_DISTANCE, 1 )
	SetFlag( TF_CHECK_DISTANCE2, 1 )
	if( WORK[WK_ISEXIST_PLAYER2] )
	{
		CheckChrDistance( TF_CHECK_DISTANCE, "PLAYER1", "PLAYER2", 0, STOPPER_WARPDIS )
	}
	if( WORK[WK_ISEXIST_PLAYER3] )
	{
		CheckChrDistance( TF_CHECK_DISTANCE2, "PLAYER1", "PLAYER3", 0, STOPPER_WARPDIS )
	}

	SetStopFlag(STOPFLAG_SIMPLEEVENT2)
	SaveCamera()

	ResetMotion( "ALL" , 0 )
	StopEffect(-1,ALL,1)
	StopEmotion( "ALL" )
	ResetMoveVec("PARTYALL")

	if( FLAG[TF_CHECK_DISTANCE]==0 || FLAG[TF_CHECK_DISTANCE2]==0)
	{
		ChrAlpha( "PLAYER2" , 0.0f , 0 )
		ChrAlpha( "PLAYER3" , 0.0f , 0 )
		ResetPartyPos()
	}
	ExecuteCmd(1, TurnToChr, "PLAYER2" , "PLAYER1" , 10.0f )
	ExecuteCmd(2, TurnToChr, "PLAYER3" , "PLAYER1" , 10.0f )
	if( FLAG[TF_CHECK_DISTANCE]==0 || FLAG[TF_CHECK_DISTANCE2]==0)
	{
		ExecuteCmd(3, ChrAlpha, "PLAYER2" , 1.0f , 10 )
		ExecuteCmd(4, ChrAlpha, "PLAYER3" , 1.0f , 10 )
		WaitThread(3)
		WaitThread(4)
	}
	WaitThread(1)
	WaitThread(2)
//�J�n���������܂�-----------------------------------------------

	Wait(15)

	SetFlag( TF_MENU_SELECT, 0 )
	YesNoMenu(TF_MENU_SELECT,"#7C��ԒT�����I�����܂����H",1)

	//����������������������������������������
	//	�˂͂�
	
	if(FLAG[TF_MENU_SELECT])
	{			
		FadeOut(FADE_BLACK,FADE_NORMAL)
		WaitFade()

		//�e���g�񕜏����E���g���C�Z�[�u
		CallFunc("system:camp_rest")
		
		SetFlag(GF_NIGHTHUNT,0)		//��ԒT���I��
		SetFlag( TF_LOADING_TIPS_OFF, 1 )	//NowLoading ���� Tips �\�����J�b�g

		LoadArg("map/mp1105/mp1105.arg")
		EventCue("mp1105:NightHunt_End")

		ResetStopFlag(STOPFLAG_SIMPLEEVENT2)
	}
	else
	{
		//�@�@�Ó]��A���̂�������SE�ɂ��Đ�����
		//�@�@���̖�c�n�ňÓ]�����đ��싖�B
		//	�˂�����


		//�@�@���̏�ő��싖�B
		//����������������������������������������

	//�I��������������----------------------------------------------------
		CrossFade(FADE_CROSS)

		SetChrPos("LEADER",60.78f,-479.46f,32.64f)
		Turn("LEADER",167.87f,360.0f)

		ResetPartyPos()
		ResetFollowPoint()
		//Wait(1) //�����҂��p

		RestoreCamera(0,0)
		ResetCameraObserver(0)
		ResetCameraZPlane()
		WaitFade()

		ResetStopFlag(STOPFLAG_SIMPLEEVENT2)
	//�I�����������܂�----------------------------------------------------
	}
}

function "NightHunt_Start"
{
	SetStopFlag(STOPFLAG_SIMPLEEVENT2)
	FadeOut(FADE_BLACK,0)
	WaitFade()

	SetChrPos("LEADER",50.79f,-395.79f,40.73f)
	Turn("LEADER",167.52f,360.0f)
	ResetPartyPos()
	ResetFollowPoint()

	MoveCameraAt( 0 , 50.790f , -395.793f , 42.592f , 0 )	// �����_
	ChangeCameraDistance( 0 , 7.000f , 0 )		// ��{����
	ChangeCameraElevation( 0 , 12.338f , 0 )	// ��{�p
	RotateCamera( 0 , 15.211f , 0 )				// �p�x
	ChangeCameraPers( 0 , 60.000f , 0 )			// ����p
	SetCameraZPlane( 0.100f , 600.000f )			// ZPlane
	RollCamera( 0 , 0.0f , 0 )				// ���[����]
	CallFunc("system:camera_reset")


	if(!FLAG[GF_HELP_A55])	//��ԒT��
	{
		// �`���[�g���A�� =================================================================================
		if ( !FLAG[SF_2NDSTART] ) {		// 2���ڔ���

			// �`���[�g���A���|�[�g���[�g�ǂݍ���
			Portrait_Load(0, "system/black.itp" )		//�[���t�F�[�h�A�E�g�p
			Portrait_Create(0, 0, 0, 0, 0, 64,64, 0.0f, 0x00ffffff, 0x00000000)
			Portrait_Load(1, "visual/help/hp_00.itp" )	// �w�i�p
			Portrait_Create(1, HELP_POS_X, HELP_POS_Y, 0, 0, HELP_SCALE_X, HELP_SCALE_Y, 0.0f, 0x00ffffff, 0x00000000)
			Portrait_Load(2, "visual/help/hp_a55.itp" )	// help_a55�F��ԒT��
			Portrait_Create(2, HELP_POS_X, HELP_POS_Y, 0, 0, HELP_SCALE_X, HELP_SCALE_Y, 0.0f, 0x00ffffff, 0x00000000)

			//��������֎~
			ResetStopFlag(STOPFLAG_AUTOMESSAGE)
			Wait(10)

			// �[���t�F�[�h�A�E�g�\��
			Portrait_Anime(0 ,PR_ANIME_SCALE, 30.0f, 17.0f, 0, 0, 0)
			Portrait_Anime(0 ,PR_ANIME_COLOR, 1.0f, 1.0f, 1.0f, 1.0f, 0)
			FadeIn(FADE_BLACK, 0)
			WaitFade()

			// �|�[�g���[�g�\��
			PlaySE(SE_TUTORIAL, 100, 0, 0, 0, 1.0f, 0)		//�`���[�g���A��
			Portrait_Anime(1, PR_ANIME_COLOR, 1.0f, 1.0f, 1.0f, 1.0f, FADE_NORMAL)	// �`���[�g���A���w�i
			Portrait_Anime(2, PR_ANIME_COLOR, 1.0f, 1.0f, 1.0f, 1.0f, FADE_NORMAL)
			Wait(FADE_NORMAL)
			Message2(1, TOPIC_BUTTUN_X, TOPIC_BUTTUN_Y, "", "", "", "", "", "", "", "", "", "")		//�{�^�����͉\���
			WaitPrompt()
			Portrait_Anime(1, PR_ANIME_COLOR, 1.0f, 1.0f, 1.0f, 0.0f, FADE_FAST)	// �`���[�g���A���w�i
			Portrait_Anime(2, PR_ANIME_COLOR, 1.0f, 1.0f, 1.0f, 0.0f, FADE_FAST)
			Wait(FADE_FAST)
			Portrait_Close(1)
			Portrait_Close(2)
			
			// �[���t�F�[�h�A�E�g�폜
			FadeOut(FADE_BLACK, 0)
			WaitFade()
			Portrait_Close(0)

			//�������苖��
			SetStopFlag(STOPFLAG_AUTOMESSAGE)
		
		}
		// ================================================================================================

		SetFlag(GF_HELP_A55,1)		// help_a55�F��ԒT��

		//PlaySE( SE_TUTORIAL , 100 , 0,  0, 0, 1.0f, 0)		//�`���[�g���A��
		////	�i���[�V����
		//TalkPopup(UNDEF,0,3,SYSTEM_PPOSX,SYSTEM_PPOSY,0)
		//{
		//	"#7C��ԒT���ł͒n�}���g�����ړ�����������܂��B\p"
		//	"#7C��ԒT�����I������ꍇ�͖�c�n�̃e���g�𒲂ׂāA"
		//	"#7C�w��ԒT�����I������x��I�����Ă��������B"
		//}
		//WaitPrompt()
		//WaitCloseWindow()
	}

	ResetStopFlag(STOPFLAG_SIMPLEEVENT2)
	FadeIn(FADE_BLACK,FADE_FAST)
}
