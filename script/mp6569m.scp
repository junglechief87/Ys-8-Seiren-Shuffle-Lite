// ���{�X��
function "EV_RetryBoss"
{
	CallFunc("rng:finalBossLevel")
	SetStopFlag(STOPFLAG_EVENT)
	FadeOut(FADE_BLACK, 0)
	WaitFade()

	//�{�X�z�u�E�A�j��--------------------------------
	SetChrPos("B030", 0.0f, -78.0f, 48.0f)
	Turn("B030", 180.0f, 360.0f)

	//PLAYER�z�u--------------------------------------
	SetChrPos("LEADER", 0.0f, -58.0f, 48.0f)
	Turn("LEADER", 0.0f, 360.0f)

	//�J�����ݒ�--------------------------------------
	// arg�̐ݒ���㏑������
	SetYs8Camera(B030_CAMERA_FIRE_NORMAL_DIST, B030_CAMERA_FIRE_NORMAL_FOV, B030_CAMERA_FIRE_NORMAL_DIP, B030_CAMERA_FIRE_NORMAL_ADDZ, B030_CAMERA_FIRE_NORMAL_ADDZ);

	MoveCameraAt( 0 , 0.000f , -58.000f , 50.366f , 0 )	// �����_
	ChangeCameraDistance(0, B030_CAMERA_FIRE_NORMAL_DIST, 0)		// ��{����
	ChangeCameraElevation(0, B030_CAMERA_FIRE_NORMAL_DIP, 0)	// ��{�p
	RotateCamera(0, 180.0f, 0)				// �p�x
	ChangeCameraPers(0, B030_CAMERA_FIRE_NORMAL_FOV, 0)			// ����p
	SetCameraZPlane(0.100f, 300.000f)			// ZPlane
	RollCamera(0, 0.0f, 0)				// ���[����]
	
	//�C�x���g�o�g���pCallFunc------------------------
	CallFunc("system:boss_start")

	//���̑�����--------------------------------------
	PlayBGM(BGM_BOSS_011, 0)

	// �C�x���g�G���A
	EventAreaEnable("SubEV_Past_07_Main060",0)

	MapAnime("CA_EVENT_boss", "close")	//�������Ȃ��X�g�b�p�[�N��
	MapAnime("CT_EVENT_boss", "close")	//�������Ȃ��X�g�b�p�[�N��
//	MapAnime("syswall", "close")

	FadeIn(FADE_BLACK, FADE_FAST)

	if (FLAG[SF_TIMEATK])
	{
		// �^�C���A�^�b�N�̏ꍇ�̓{�X���o���Ă�����
		VisualName("visual/bossname/bn_b030.itp", VN_NAMEBOSS2, VN_BOSSNAME_LT_X, VN_BOSSNAME_LT_Y, VN_BOSSNAME_TIME)
	}

	WaitFade()

	ResetStopFlag(STOPFLAG_EVENT)
	//------------------------------------------------
}

// �{�X���S�F���{�X
function "EV_Boss_Dead"
{
	//���GON�E�F�X�I��������---------------------------

	SetFlag(SF_ALLMUTEKI,1)		//���G�n�m

//	Wait(180)
	Wait(250)
	StopBGM(120)
	Wait(60)

	//�C�x���g�o�g���pCallFunc-------------------------
	// SF_BOSS_BATTLE�̂݃C�x���g���őΏ����ĉ�����
	CallFunc("system:boss_end")


	//���������E�{�X����-------------------------------
	MapAnime("CA_EVENT_boss", "open")	//�������Ȃ��X�g�b�p�[�J����
	MapAnime("CT_EVENT_boss","open")	//�������Ȃ��X�g�b�p�[�J����
//	MapAnime("syswall", "open")

	SetChrPos("B030",-100000.00f,0.00f,0.00f)

	//���㏈��-----------------------------------------
	// �^�C���A�^�b�N��
	if (FLAG[SF_TIMEATK])
	{
		EndTimeAtk()		// �^�C���A�^�b�N�I���i�X�N���v�g���狭���I�ɔ����Ă��낢�돈�����Ă����j
		ResetStopFlag(STOPFLAG_EVENT)
	}
	else if (FLAG[SF_EVENT_ON])
	{
		EventCue("mp6569m:SubEV_Past_07_Main061")
		ResetStopFlag(STOPFLAG_EVENT)
	}
	else
	{
		// �{�X���b�V���H
		FadeIn(FADE_WHITE,FADE_FAST)
		WaitFade()

		ResetStopFlag(STOPFLAG_EVENT)
	}
	//------------------------------------------------
}

