function "it_foodstuff01"//	岩塩
{
	if (this.CHRWORK[CWK_MAXHP] > this.CHRWORK[CWK_HP])
	{
		// 使っていい
		HP_Heal( this , 2)
		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_FD_SEA_SALT, 1)

	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_FD_SEA_SALT)

		PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}
}

