function "HealVoice"//回復ボイス
{
	if (this.CHRWORK[CWK_CHRID] == ADOL)
	{
		PlayVoice(Y8V_0037,"ADOL",100)			//まだまだ行ける！
	}
	else if (this.CHRWORK[CWK_CHRID] == LAXIA)
	{
		PlayVoice(Y8V_0237,"LAXIA",100)			// まだまだ行けます！
	}
	else if (this.CHRWORK[CWK_CHRID] == SAHAD)
	{
		PlayVoice(Y8V_1281,"SAHAD",100)			// おし、ガンガン行くぜ！
	}
	else if (this.CHRWORK[CWK_CHRID] == HUMMEL)
	{
		PlayVoice(Y8V_2043,"HUMMEL",100)		// ここからが本番だ！
	}
	else if (this.CHRWORK[CWK_CHRID] == RICOTTA)
	{
		PlayVoice(Y8V_2426,"RICOTTA",100)		// なはは、癒される！
	}
	else if (this.CHRWORK[CWK_CHRID] == DANA)
	{
		PlayVoice(Y8V_2864,"DANA",100)			// まだまだ行けるよ！
	}
}

/////////////////////////////////////
// 復活薬系
function "it_res1"
{
	SetFlag(TF_MENU_SELECT2, 1)
	if (this.CHRWORK[CWK_MAXHP] <= this.CHRWORK[CWK_HP])
	{
		PlaySE( SE_CAMPMENU , 100 , 0,  0, 0, 1.0f, 0)
		YesNoMenu(TF_MENU_SELECT2,"回復する必要がありませんが、使用しますか？",0)
	}

	if( FLAG[TF_MENU_SELECT2] )
	{
		// 使っていい
		// 復活薬１（１０％回復）
		HP_ORecover( this , (this.CHRWORK[CWK_MAXHP] * 0.1f))
		PlaySE( SE_ITEM_SERUSETA , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_US_RESSURECT_01, 1)
		if(!FLAG[SF_INFERNO])	//INFERNOでは空き瓶残らない
		{
			Wait(5)
			GetItem(ICON3D_EV_EMPTY_BOTTLE,1)
			GetItemMessageExPlus( ICON3D_EV_EMPTY_BOTTLE, 1 , ITEMMSG_SE_BETTER , "が残った。" , 0 , 0 )
			WaitPrompt()
			WaitCloseWindow()
		}
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_US_RESSURECT_01)
//		PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}
}

