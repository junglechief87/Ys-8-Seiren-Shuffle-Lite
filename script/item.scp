function "it_cureall"
{
	if (this.CHRWORK[CWK_POISON] ||
		this.CHRWORK[CWK_PARALYZE] ||
		this.CHRWORK[CWK_FLAME] ||
		this.CHRWORK[CWK_FREEZE] ||
		this.CHRWORK[CWK_DARK] ||
		this.CHRWORK[CWK_BLOODLOSS])
	{
		// 使っていい
		Cure(this, EFXFLAG1_POISON)
		Cure(this, EFXFLAG1_PARALYZE)
		Cure(this, EFXFLAG1_FLAME)
		Cure(this, EFXFLAG1_FREEZE)
		Cure(this, EFXFLAG1_DARK)
		Cure(this, EFXFLAG1_BLOOD_LOSS)
	
		PlaySE( SE_CURE , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_US_CURE_ALL, 1)
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_US_CURE_ALL)

		PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}
}

