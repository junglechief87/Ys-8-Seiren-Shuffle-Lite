/////////////////////////////////////
// ベスティアリポーション
function "it_bestiary"
{
	// 消費する
	UseItem(ICON3D_US_BESTIARYPT, 1)

	//SetStopFlag(STOPFLAG_SIMPLEEVENT)
	//SetStopFlag(STOPFLAG_FREEZE)
	//ResetMoveVec("PARTYALL")

	// ＨＰアップ
	SetChrWork(this,CWK_SUP_MAXHP,(this.CHRWORK[CWK_SUP_MAXHP] + 100))
	// ＳＴＲアップ
	SetChrWork(this,CWK_SUP_STR,(this.CHRWORK[CWK_SUP_STR] + 3))
	// ＤＥＦアップ
	SetChrWork(this,CWK_SUP_DEF,(this.CHRWORK[CWK_SUP_DEF] + 3))


	PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

//	Wait(30)

	Message("#4CＨＰの最大値が１００増えた。\n#4CＳＴＲが３増えた。\n#4CＤＥＦが３増えた。\n#4C獣の落とすアイテムがわかるようになった。")
	WaitPrompt()
	//Wait(10)
	WaitCloseWindow()

	SetFlag(SF_BESTIARYPOTION, 1)

	//ResetStopFlag(STOPFLAG_FREEZE)
	//ResetStopFlag(STOPFLAG_SIMPLEEVENT)
}

/////////////////////////////////////
// 鬼神の霊香
function it_spup
{
	SetFlag( TF_MENU_SELECT2, 0 )
	YesNoMenu(TF_MENU_SELECT2,"#2C鬼神の霊香#0Cを使いますか？",1)
	
	if( FLAG[TF_MENU_SELECT2] )
	{
		// 消費する
		UseItem(ICON3D_US_ADD_SP, 1)

		//SetStopFlag(STOPFLAG_SIMPLEEVENT)
		//SetStopFlag(STOPFLAG_FREEZE)
		//ResetMoveVec("PARTYALL")

		// ＳＰの最大値増やす
		SetFlag(SF_SPMAX, (FLAG[SF_SPMAX]+10) )
		if( FLAG[SF_SPMAX] >200 )
		{
			SetFlag(SF_SPMAX,200)		//最大で２００
		}

		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

	//	Wait(30)

		Message("#4CＳＰの最大値が１０増えた。")
		WaitPrompt()
		//Wait(10)
		WaitCloseWindow()

		//ResetStopFlag(STOPFLAG_FREEZE)
		//ResetStopFlag(STOPFLAG_SIMPLEEVENT)
	}
}

/////////////////////////////////////
// 修験者の秘薬
function it_lvup
{
	if (this.CHRWORK[CWK_LV] < LV_MAX )
	{
		// 消費する
		UseItem(ICON3D_US_ADD_LEVEL, 1)

		//SetStopFlag(STOPFLAG_SIMPLEEVENT)
		//SetStopFlag(STOPFLAG_FREEZE)
		//ResetMoveVec("PARTYALL")

		// レベルアップに必要な経験値を取得することで、レベルアップする。
		GetExp((this.CHRWORK[CWK_EXPNEXTLV]))

		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

	//	Wait(30)

		Message("#4Cレベルが１上がった。")			//システムのエフェクトがあれば、メッセージいらないかも。
		WaitPrompt()
		//Wait(10)
		WaitCloseWindow()

		//ResetStopFlag(STOPFLAG_FREEZE)
		//ResetStopFlag(STOPFLAG_SIMPLEEVENT)
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_US_ADD_LEVEL)

		PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}
}

