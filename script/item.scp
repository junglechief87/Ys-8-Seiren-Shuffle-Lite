function "it_res2"
{
	SetFlag(TF_MENU_SELECT2, 1)
	if (this.CHRWORK[CWK_MAXHP] <= this.CHRWORK[CWK_HP] &&
		!this.CHRWORK[CWK_DARK] && !this.CHRWORK[CWK_PARALYZE] && !this.CHRWORK[CWK_POISON] &&
		!this.CHRWORK[CWK_FREEZE] && !this.CHRWORK[CWK_FLAME] &&  !this.CHRWORK[CWK_BLOODLOSS])
	{
		PlaySE( SE_CAMPMENU , 100 , 0,  0, 0, 1.0f, 0)
		YesNoMenu(TF_MENU_SELECT2,"回復する必要がありませんが、使用しますか？",0)
	}

	if( FLAG[TF_MENU_SELECT2] )
	{
		// 使っていい
		// 復活薬２（１００％回復）
		HP_ORecover( this , (this.CHRWORK[CWK_MAXHP]))

		//状態異常も完全回復
		Cure(this, (EFXFLAG1_DARK | EFXFLAG1_PARALYZE | EFXFLAG1_POISON | EFXFLAG1_FREEZE | EFXFLAG1_FLAME | EFXFLAG1_BLOOD_LOSS))
		PlaySE( SE_ITEM_SERUSETA , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_US_RESSURECT_02, 1)
		if(!FLAG[SF_INFERNO])	//INFERNOでは空き瓶残らない
		{
			Wait(5)
			GetItem(ICON3D_EV_EMPTY_BOTTLE,1)
			GetItemMessageExPlus( ICON3D_EV_EMPTY_BOTTLE, 1 , ITEMMSG_SE_BETTER , "が残った。" , 0 , 0 )
			WaitPrompt()
			WaitCloseWindow()
		}
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_US_RESSURECT_02)
//		PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}
}

