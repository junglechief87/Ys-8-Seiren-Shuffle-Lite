/////////////////////////////////////
// テスト・アイテムスクリプト

/////////////////////////////////////
// 蜂の巣除去（仮）　※メニュー上でアイテム使った時に呼ばれる
function "it_pestcide"
{
	SetFlag( TF_MENU_SELECT2, 0 )
	YesNoMenu(TF_MENU_SELECT2,"#2C虫駆除剤#0Cを使いますか？",1)
	
	if( FLAG[TF_MENU_SELECT2] )
	{
		// 使っていい
		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_US_PESTCIDE, 1)

		// アイテムスクリプトスレッドで実際の効果を実行
		ItemCue("item:do_pestcide")

		// キャンプメニューを閉じる
		MenuClose(0, 0)
	}
}

/////////////////////////////////////
// 蜂の巣除去（仮）　※実際にゲーム上で効果を発揮する際に呼ばれる
function "do_pestcide"
{
	ChrEffect(PLAYER1, SYSEFX_ITEM_PESTCIDE, 0, 0, 0, 0, 0, IMPACT_NONE, KNOCK_EFXPOS, 0.0f, 0.0f, EFXFLAG1_NODMGMISSILE, 1.0f, 1.0f)
}

/////////////////////////////////////
// 探索の心得《森》
function it_search_book01
{
	SetFlag( TF_MENU_SELECT2, 0 )
	YesNoMenu(TF_MENU_SELECT2,"#2C探索の心得《森》#0Cを使いますか？\n冒険具の#2C装備数#0Cが１つ増加します。",1)
	
	if( FLAG[TF_MENU_SELECT2] )
	{
		// 消費する
		UseItem(ICON3D_US_SEARCH_BOOK01, 1)

		//SetStopFlag(STOPFLAG_SIMPLEEVENT)
		//SetStopFlag(STOPFLAG_FREEZE)
		//ResetMoveVec("PARTYALL")

		// 装備欄の数増やす
		SetFlag(SF_ITEMSLOT_NUM, (FLAG[SF_ITEMSLOT_NUM]+1) )
		if( FLAG[SF_ITEMSLOT_NUM] >ITEMSLOT_MAX )	//最大数チェック
		{
			SetFlag(SF_ITEMSLOT_NUM, ITEMSLOT_MAX)
		}

//		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)
		PlaySE( SE_TUTORIAL , 100 , 0,  0, 0, 1.0f, 0)		//チュートリアル

		Message("#4C冒険具の装備数が１つ増えた。")
		WaitPrompt()
		//Wait(10)
		WaitCloseWindow()

		//ResetStopFlag(STOPFLAG_FREEZE)
		//ResetStopFlag(STOPFLAG_SIMPLEEVENT)

	//	// キャンプメニューを閉じる・閉じないと更新されない
	//	MenuClose(0, 0)
	}
}

