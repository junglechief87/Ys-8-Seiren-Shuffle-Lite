// ＥＸＴＲＡ薬系
function "it_extra_up1"
{
	SetFlag(TF_MENU_SELECT2, 1)
	if (FLAG[SF_EXPOWER] >= MAX_EXTRA)
	{
		PlaySE( SE_CAMPMENU , 100 , 0,  0, 0, 1.0f, 0)
		YesNoMenu(TF_MENU_SELECT2,"回復する必要がありませんが、使用しますか？",0)
	}

	if( FLAG[TF_MENU_SELECT2] )
	{
		// 使っていい
		// ＥＸＴＲＡ薬１（５０％回復）
		AddEX(50.0f)
		PlaySE( SE_ITEM_SERUSETA , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_US_EXTRA_01, 1)
		if(!FLAG[SF_INFERNO])	//INFERNOでは空き瓶残らない
		{
			Wait(5)
			GetItem(ICON3D_EV_EMPTY_BOTTLE,1)
			GetItemMessageExPlus( ICON3D_EV_EMPTY_BOTTLE, 1 , ITEMMSG_SE_BETTER , "が残った。" , 0 , 0 )
			WaitPrompt()
			WaitCloseWindow()
		}
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_US_EXTRA_01)
//		PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}
}

