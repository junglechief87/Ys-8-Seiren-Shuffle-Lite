			(RICOTTA.CHRWORK[CWK_MAXHP] <= RICOTTA.CHRWORK[CWK_HP])&&
			(DANA.CHRWORK[CWK_MAXHP] <= DANA.CHRWORK[CWK_HP]))
		//if (this.CHRWORK[CWK_MAXHP] <= this.CHRWORK[CWK_HP])
		{
			SetFlag( TF_MENU_SELECT2, 0 )
			PlaySE( SE_CAMPMENU , 100 , 0,  0, 0, 1.0f, 0)
			YesNoMenu(TF_MENU_SELECT2,"ＨＰを回復する必要がありませんが、使用しますか？",0)
		}
	}
	
	if( FLAG[TF_MENU_SELECT2] )
	{
		// 使っていい
		HP_Heal( ADOL ,    1500)
		HP_Heal( LAXIA ,   1500)
		HP_Heal( SAHAD ,   1500)
		HP_Heal( HUMMEL ,  1500)
		HP_Heal( RICOTTA , 1500)
		HP_Heal( DANA ,    1500)
		
		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)
		UseFood(FOODEFFID_EXPUP2)			// 入手経験値アップ2

		// 消費する
		UseItem(ICON3D_USFD_FOOD12, 1)

		SetFlag( TF_VOICEPLY_CHR, 0)			// 必要ないがおまじない
		SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))

		SetFlag(TF_MENU_SELECT,0)					
		while(!FLAG[TF_MENU_SELECT])		//選択されたキャラが死亡している場合シャッフルする
		{
			if((FLAG[TF_VOICEPLY_CHR] == ADOL) && (ADOL.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == LAXIA) && (LAXIA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == SAHAD) && (SAHAD.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == HUMMEL) && (HUMMEL.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == RICOTTA) && (RICOTTA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == DANA) && (DANA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else 
			{
				SetFlag(TF_MENU_SELECT,1)					
			}
		}

		if(FLAG[TF_VOICEPLY_CHR] == ADOL)
		{
			PlayVoice(Y8V_0037,"ADOL",100)			//まだまだ行ける！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == LAXIA)
		{
			PlayVoice(Y8V_0237,"LAXIA",100)			// まだまだ行けます！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == SAHAD)
		{
			PlayVoice(Y8V_1281,"SAHAD",100)			// おし、ガンガン行くぜ！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == HUMMEL)
		{
			PlayVoice(Y8V_2043,"HUMMEL",100)		// ここからが本番だ！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == RICOTTA)
		{
			PlayVoice(Y8V_2426,"RICOTTA",100)		// なはは、癒される！
		}
		else
		{
			PlayVoice(Y8V_2864,"DANA",100)			// まだまだ行けるよ！
		}
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_USFD_FOOD12)

		//PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}

}
