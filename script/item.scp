		//SetStopFlag(STOPFLAG_FREEZE)
		//ResetMoveVec("PARTYALL")

		// 装備欄の数増やす
		SetFlag(SF_ITEMSLOT_NUM, (FLAG[SF_ITEMSLOT_NUM]+1) )
		if( FLAG[SF_ITEMSLOT_NUM] >ITEMSLOT_MAX )	//最大数チェック
		{
			SetFlag(SF_ITEMSLOT_NUM, ITEMSLOT_MAX)
		}

//		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)
		PlaySE( SE_TUTORIAL , 100 , 0,  0, 0, 1.0f, 0)		//チュートリアル

		Message("#4C冒険具の装備数が１つ増えた。")
		WaitPrompt()
		//Wait(10)
		WaitCloseWindow()

		//ResetStopFlag(STOPFLAG_FREEZE)
		//ResetStopFlag(STOPFLAG_SIMPLEEVENT)

	//	// キャンプメニューを閉じる・閉じないと更新されない
	//	MenuClose(0, 0)
	}
}

