/////////////////////////////////////
// 状態異常回復系

//※「一定時間予防」が正式仕様になれば、使えるかどうか判定はいらない

function "it_cure1"
{

	if (this.CHRWORK[CWK_POISON])
	{
		// 使っていい
		// 毒回復
		Cure(this, EFXFLAG1_POISON)

		PlaySE( SE_CURE , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_US_CURE_POISON, 1)
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
