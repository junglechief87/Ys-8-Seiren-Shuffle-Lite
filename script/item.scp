function "FoodVoice"//料理ボイス
{
	SetFlag( TF_VOICEPLY_CHR, 0)			// 必要ないがおまじない
	SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))

	SetFlag(TF_MENU_SELECT,0)					
	while(!FLAG[TF_MENU_SELECT])		//選択されたキャラが死亡している場合シャッフルする
	{
		if((FLAG[TF_VOICEPLY_CHR] == ADOL) && (ADOL.CHRWORK[CWK_HP] <= 0 ))
		{
			SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
		}
		else if((FLAG[TF_VOICEPLY_CHR] == LAXIA) && (LAXIA.CHRWORK[CWK_HP] <= 0 ))
		{
			SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
		}
		else if((FLAG[TF_VOICEPLY_CHR] == SAHAD) && (SAHAD.CHRWORK[CWK_HP] <= 0 ))
		{
			SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
		}
		else if((FLAG[TF_VOICEPLY_CHR] == HUMMEL) && (HUMMEL.CHRWORK[CWK_HP] <= 0 ))
		{
			SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
		}
		else if((FLAG[TF_VOICEPLY_CHR] == RICOTTA) && (RICOTTA.CHRWORK[CWK_HP] <= 0 ))
		{
			SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
		}
		else if((FLAG[TF_VOICEPLY_CHR] == DANA) && (DANA.CHRWORK[CWK_HP] <= 0 ))
		{
			SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
		}
		else 
		{
			SetFlag(TF_MENU_SELECT,1)					
		}
	}

	if(FLAG[TF_VOICEPLY_CHR] == ADOL)
	{
		PlayVoice(Y8V_0037,"ADOL",100)			//まだまだ行ける！
	}
	else if(FLAG[TF_VOICEPLY_CHR] == LAXIA)
	{
		PlayVoice(Y8V_0237,"LAXIA",100)			// まだまだ行けます！
	}
	else if(FLAG[TF_VOICEPLY_CHR] == SAHAD)
	{
		PlayVoice(Y8V_1281,"SAHAD",100)			// おし、ガンガン行くぜ！
	}
	else if(FLAG[TF_VOICEPLY_CHR] == HUMMEL)
	{
		PlayVoice(Y8V_2043,"HUMMEL",100)		// ここからが本番だ！
	}
	else if(FLAG[TF_VOICEPLY_CHR] == RICOTTA)
	{
		PlayVoice(Y8V_2426,"RICOTTA",100)		// なはは、癒される！
	}
	else
	{
		PlayVoice(Y8V_2864,"DANA",100)			// まだまだ行けるよ！
	}		
}
/////////////////////////////////////
// 料理
//
// それぞれの効果は balance.csv
// その効果時間は item.csv
// 回復量は ％はやめて、固定値に。最初のを500。最高を3000にする。


function "it_usfood01"	//魚介スープ
{
	if( WORK[WK_FOODEFFTIME] > 0 ){
		SetFlag( TF_MENU_SELECT2, 0 )
		PlaySE( SE_TUTORIAL , 100 , 0,  0, 0, 1.0f, 0)		//チュートリアル
		TalkPopup(UNDEF,0,5,0,0,0)
		{
			"#8S"
			"#-1W#4C料理の効果が続いている間は、食べられません。#10W" 
			"#8S"
		}
		Wait(10)
		WaitPrompt()
		WaitCloseWindow()
	}
	else{
		SetFlag( TF_MENU_SELECT2, 1 )
		if ((ADOL.CHRWORK[CWK_MAXHP] <= ADOL.CHRWORK[CWK_HP])&&
			(LAXIA.CHRWORK[CWK_MAXHP] <= LAXIA.CHRWORK[CWK_HP])&&
			(SAHAD.CHRWORK[CWK_MAXHP] <= SAHAD.CHRWORK[CWK_HP])&&
			(HUMMEL.CHRWORK[CWK_MAXHP] <= HUMMEL.CHRWORK[CWK_HP])&&
			(RICOTTA.CHRWORK[CWK_MAXHP] <= RICOTTA.CHRWORK[CWK_HP])&&
			(DANA.CHRWORK[CWK_MAXHP] <= DANA.CHRWORK[CWK_HP]))
		//if (this.CHRWORK[CWK_MAXHP] <= this.CHRWORK[CWK_HP])
		{
			SetFlag( TF_MENU_SELECT2, 0 )
			PlaySE( SE_CAMPMENU , 100 , 0,  0, 0, 1.0f, 0)
			YesNoMenu(TF_MENU_SELECT2,"ＨＰを回復する必要がありませんが、使用しますか？",0)
		}
	}

	if( FLAG[TF_MENU_SELECT2] )
	{
		// 使っていい
		HP_Heal( ADOL ,    400)
		HP_Heal( LAXIA ,   400)
		HP_Heal( SAHAD ,   400)
		HP_Heal( HUMMEL ,  400)
		HP_Heal( RICOTTA , 400)
		HP_Heal( DANA ,    400)

		UseFood(FOODEFFID_BREAKUP1)			// 与ブレイク量アップ1
		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_USFD_FOOD00, 1)

		SetFlag( TF_VOICEPLY_CHR, 0)			// 必要ないがおまじない
		SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))

		SetFlag(TF_MENU_SELECT,0)					
		while(!FLAG[TF_MENU_SELECT])		//選択されたキャラが死亡している場合シャッフルする
		{
			if((FLAG[TF_VOICEPLY_CHR] == ADOL) && (ADOL.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == LAXIA) && (LAXIA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == SAHAD) && (SAHAD.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == HUMMEL) && (HUMMEL.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == RICOTTA) && (RICOTTA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == DANA) && (DANA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else 
			{
				SetFlag(TF_MENU_SELECT,1)					
			}
		}

		SetFlag(TF_MENU_SELECT,0)					
		while(!FLAG[TF_MENU_SELECT])		//選択されたキャラが死亡している場合シャッフルする
		{
			if((FLAG[TF_VOICEPLY_CHR] == ADOL) && (ADOL.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == LAXIA) && (LAXIA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == SAHAD) && (SAHAD.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == HUMMEL) && (HUMMEL.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == RICOTTA) && (RICOTTA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == DANA) && (DANA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else 
			{
				SetFlag(TF_MENU_SELECT,1)					
			}
		}

		if(FLAG[TF_VOICEPLY_CHR] == ADOL)
		{
			PlayVoice(Y8V_0037,"ADOL",100)			//まだまだ行ける！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == LAXIA)
		{
			PlayVoice(Y8V_0237,"LAXIA",100)			// まだまだ行けます！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == SAHAD)
		{
			PlayVoice(Y8V_1281,"SAHAD",100)			// おし、ガンガン行くぜ！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == HUMMEL)
		{
			PlayVoice(Y8V_2043,"HUMMEL",100)		// ここからが本番だ！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == RICOTTA)
		{
			PlayVoice(Y8V_2426,"RICOTTA",100)		// なはは、癒される！
		}
		else
		{
			PlayVoice(Y8V_2864,"DANA",100)			// まだまだ行けるよ！
		}
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_USFD_FOOD00)

		//PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}
	

}
function "it_usfood02"	//キノコオムレツ
{
	if( WORK[WK_FOODEFFTIME] > 0 ){
		SetFlag( TF_MENU_SELECT2, 0 )
		PlaySE( SE_TUTORIAL , 100 , 0,  0, 0, 1.0f, 0)		//チュートリアル
		TalkPopup(UNDEF,0,5,0,0,0)
		{
			"#8S"
			"#-1W#4C料理の効果が続いている間は、食べられません。#10W" 
			"#8S"
		}
		Wait(10)
		WaitPrompt()
		WaitCloseWindow()
	}
	else{
		SetFlag( TF_MENU_SELECT2, 1 )
		if ((ADOL.CHRWORK[CWK_MAXHP] <= ADOL.CHRWORK[CWK_HP])&&
			(LAXIA.CHRWORK[CWK_MAXHP] <= LAXIA.CHRWORK[CWK_HP])&&
			(SAHAD.CHRWORK[CWK_MAXHP] <= SAHAD.CHRWORK[CWK_HP])&&
			(HUMMEL.CHRWORK[CWK_MAXHP] <= HUMMEL.CHRWORK[CWK_HP])&&
			(RICOTTA.CHRWORK[CWK_MAXHP] <= RICOTTA.CHRWORK[CWK_HP])&&
			(DANA.CHRWORK[CWK_MAXHP] <= DANA.CHRWORK[CWK_HP]))
		//if (this.CHRWORK[CWK_MAXHP] <= this.CHRWORK[CWK_HP])
		{
			SetFlag( TF_MENU_SELECT2, 0 )
			PlaySE( SE_CAMPMENU , 100 , 0,  0, 0, 1.0f, 0)
			YesNoMenu(TF_MENU_SELECT2,"ＨＰを回復する必要がありませんが、使用しますか？",0)
		}
	}

	if( FLAG[TF_MENU_SELECT2] )
	{
		// 使っていい
		HP_Heal( ADOL ,    350)
		HP_Heal( LAXIA ,   350)
		HP_Heal( SAHAD ,   350)
		HP_Heal( HUMMEL ,  350)
		HP_Heal( RICOTTA , 350)
		HP_Heal( DANA ,    350)

		//状態異常も完全回復
		Cure(ADOL, (EFXFLAG1_DARK | EFXFLAG1_PARALYZE | EFXFLAG1_POISON | EFXFLAG1_FREEZE | EFXFLAG1_FLAME | EFXFLAG1_BLOOD_LOSS))
		Cure(LAXIA, (EFXFLAG1_DARK | EFXFLAG1_PARALYZE | EFXFLAG1_POISON | EFXFLAG1_FREEZE | EFXFLAG1_FLAME | EFXFLAG1_BLOOD_LOSS))
		Cure(SAHAD, (EFXFLAG1_DARK | EFXFLAG1_PARALYZE | EFXFLAG1_POISON | EFXFLAG1_FREEZE | EFXFLAG1_FLAME | EFXFLAG1_BLOOD_LOSS))
		Cure(HUMMEL, (EFXFLAG1_DARK | EFXFLAG1_PARALYZE | EFXFLAG1_POISON | EFXFLAG1_FREEZE | EFXFLAG1_FLAME | EFXFLAG1_BLOOD_LOSS))
		Cure(RICOTTA, (EFXFLAG1_DARK | EFXFLAG1_PARALYZE | EFXFLAG1_POISON | EFXFLAG1_FREEZE | EFXFLAG1_FLAME | EFXFLAG1_BLOOD_LOSS))
		Cure(DANA, (EFXFLAG1_DARK | EFXFLAG1_PARALYZE | EFXFLAG1_POISON | EFXFLAG1_FREEZE | EFXFLAG1_FLAME | EFXFLAG1_BLOOD_LOSS))
		UseFood(FOODEFFID_CURE1)			// 状態異常回復、無効化１
		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_USFD_FOOD01, 1)

		SetFlag( TF_VOICEPLY_CHR, 0)			// 必要ないがおまじない
		SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))

		SetFlag(TF_MENU_SELECT,0)					
		while(!FLAG[TF_MENU_SELECT])		//選択されたキャラが死亡している場合シャッフルする
		{
			if((FLAG[TF_VOICEPLY_CHR] == ADOL) && (ADOL.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == LAXIA) && (LAXIA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == SAHAD) && (SAHAD.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == HUMMEL) && (HUMMEL.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == RICOTTA) && (RICOTTA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else if((FLAG[TF_VOICEPLY_CHR] == DANA) && (DANA.CHRWORK[CWK_HP] <= 0 ))
			{
				SetFlag( TF_VOICEPLY_CHR, (WORK[WK_RANDJOINMB]))
			}
			else 
			{
				SetFlag(TF_MENU_SELECT,1)					
			}
		}

		if(FLAG[TF_VOICEPLY_CHR] == ADOL)
		{
			PlayVoice(Y8V_0037,"ADOL",100)			//まだまだ行ける！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == LAXIA)
		{
			PlayVoice(Y8V_0237,"LAXIA",100)			// まだまだ行けます！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == SAHAD)
		{
			PlayVoice(Y8V_1281,"SAHAD",100)			// おし、ガンガン行くぜ！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == HUMMEL)
		{
			PlayVoice(Y8V_2043,"HUMMEL",100)		// ここからが本番だ！
		}
		else if(FLAG[TF_VOICEPLY_CHR] == RICOTTA)
		{
			PlayVoice(Y8V_2426,"RICOTTA",100)		// なはは、癒される！
		}
		else
		{
			PlayVoice(Y8V_2864,"DANA",100)			// まだまだ行けるよ！
		}
	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_USFD_FOOD01)

		//PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
