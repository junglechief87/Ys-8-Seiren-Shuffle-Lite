/////////////////////////////////////
// 果物
function "it_fruits01"
{

	if (this.CHRWORK[CWK_MAXHP] > this.CHRWORK[CWK_HP])
	{
		// 使っていい
		// クルの実（１００回復）
		HP_Heal( this , 100)
		PlaySE( SE_HEAL , 100 , 0,  0, 0, 1.0f, 0)

		// 消費する
		UseItem(ICON3D_US_BERRY, 1)

	}
	else
	{
		// 使っちゃだめ	// 消費した分を戻す
		SetCantUseItem(ICON3D_US_BERRY)

		PlaySE( SE_BOOBOO, 100, 0,  0, 0, 1.0f, 0)
	}

}

