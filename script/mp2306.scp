	//SetMapMarker( SMI_LOCATION ,PAGE_MP230x, MARKER_EV_LC_MP2306, 300.59f,-2.19f,12.86f, 300.59f,-2.19f,LOCATION_MP2306,MN_D_MP2306,0)		//���P�@�F�򑐂̌Q���n

	//�~�j�}�b�v�J��
