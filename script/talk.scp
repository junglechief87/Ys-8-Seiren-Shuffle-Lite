			//�@�@���J�����؂�ւ��Ȃ�
			LookChr("this", "LEADER")
		}
		
		if( !FLAG[TF_RICOTTA_QS_TALK] )
		{
			TalkPopup("Ricotta",0,0,0,0,0)
			{
				"#040e#000m���R�b�^�A�ŋ߂悭�v���B"
				"�����Ƃ����Ƌ����Ȃ肽���B\p"
				"#030e�����w���n�}���S�[�x�����āA"
				"������[�̂Ƃ���s���I\p"
				"�����Čm�ÁA�t���Ă��炤�I"
			}
			WaitPrompt()
			WaitCloseWindow()
		}
		else
		{
			//�@�@���J��Ԃ�
			//�@�@���J�����؂�ւ��Ȃ�
			TalkPopup("Ricotta",0,0,0,0,0)
			{
				"#000e#000m�����w���n�}���S�[�x�����āA"
				"������[�̂Ƃ���s���I\p2"
				"�����Čm�ÁA�t���Ă��炤�I2"
			}
			WaitPrompt()
			WaitCloseWindow()
		}
		
		if( FLAG[GF_NPC_4_01_GOTO_NORTH] &&			//����l���@���k���ɑ��𓥂ݓ��ꂽ
			!FLAG[GF_NPC_4_01_OCCUR_INTERCEPT7] &&	//�I����l���e�}����F������
			!FLAG[TF_RICOTTA_QS_TALK] )
		{
			Turn("Ricotta", 8.40f, 360.0f)
			CallFunc("system:talkevent_end")		//TALK_END
			SetStopFlag(STOPFLAG_TALK)
			SetFlag( TF_TALK_ZOOMNOINTERPOLATE, 1 )	//ZOOMCAMERA�Ɋւ����ԏ�������u�ŏI��点��
			CallFunc("system:talk_begin_zoom")		//TALK_ZOOM
		}
		
		SetFlag( TF_RICOTTA_QS_TALK, 1 )
	}
}
