	//Wait(1)		// �I�������莞�p
	//������������������������������
	//	�ꏊ		�F�L��E���̑�
	//������������������������������
	//	�z�u�E�J�����F����p�^���g���p���u����񕔂e�}����B�������v
	//				  -49.02f, -1438.43f, 29.60f ,-98.27f
	//				  ���g���p�����ۑ��֎q�̏�ɂ���A
	//				  �����ɂ���n�V�r���R�E�Ƃ����������Ă���
	//	���[�V����	�F
	//������������������������������
	SaveCamera()
	ChangeCameraPers( 0 , 60.000f , 0 )	// ����p
	SetCameraZPlane( 0.100f , 300.000f )	// ZPlane
