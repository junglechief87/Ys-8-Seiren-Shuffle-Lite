// ����b�^�i�g�X
function "Talk_Thanatos"
{
	//��b���[�v�����t���O�����낷�i���p�b�`1.01�Ή��j
	SetFlag( GF_QS_EVENT_TMP, 0 )				//1:�N�G�X�g�C�x���g����

	// ��b�������`�F�b�N
	SetFlag( TF_TALK_TYPE, 0 )
	if( ALLITEMWORK[ICON3D_PRESENT_THANATOS] &&	//�u��������̖��N�M�v
		FLAG[GF_NPC_6_02_GOTO_GEND])			//�����^�C�~���O�F����Z���A�W�����_��������֌�����
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x02 ) )	// 0x02:�v���[���g�A�C�e������
	}
	if( FLAG[GF_QUEST_521] == QUEST_BBS || FLAG[GF_QUEST_521] == QUEST_START ) 
