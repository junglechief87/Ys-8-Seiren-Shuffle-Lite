	MoveCameraAt( 0 , -48.521f , -1439.281f , 30.189f , 0 )	// �����_
	MoveCamera( 0 , -49.096f , -1440.557f , 30.256f , 0 )		// ���_
	
	LookSpd("Paro", 1.0f, 1.0f, 1.0f)
	LookChr("Paro" , "Rex" )
	LookSpd("Paro", LOOKSPD_DEFAULT, LOOKSPD_DEFAULT, LOOKSPD_DEFAULT)

	//�L������������̋L�q
	//LookSpd("this", 1.0f, 1.0f, 1.0f)
