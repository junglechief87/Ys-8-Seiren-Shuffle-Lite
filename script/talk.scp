// ����b�~�����_
function "Talk_Miralda"
{
	//��b���[�v�����t���O�����낷�i���p�b�`1.01�Ή��j
	SetFlag( GF_QS_EVENT_TMP, 0 )				//1:�N�G�X�g�C�x���g����

	// ��b�������`�F�b�N
	SetFlag( TF_TALK_TYPE, 0 )
	if(FLAG[DF_JOIN_MIRALDA])	//�~�����_��������
	{
		SetDiaryShopFlag(SHOP_ID_JUICE,1)// �f�ގ蒠�ւ̃����N��ON
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x40 ) )	// 0x40:�V���b�v�p�I����
	}
	if( ALLITEMWORK[ICON3D_PRESENT_MIRALDA] &&	//�u�����̕�v
		FLAG[GF_NPC_5_02_GOTO_BAHA] )			//����ܕ��A�o�n�̓��Ɍ�����
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x02 ) )	// 0x02:�v���[���g�A�C�e������
	}
	if (FLAG[GF_QUEST_402] == QUEST_BBS || FLAG[GF_QUEST_402] == QUEST_START)	// �yQS402�z�h�{���_�̓������i�~�����_�j �N�G�X�g�B�����s�O
	{
		//�u����l���@���k���ɑ��𓥂ݓ��ꂽ�v���߂�����
		if (FLAG[GF_NPC_4_01_AFTER_INTERCEPT7] || FLAG[GF_NPC_5_01_BEFORE_INTERCEPT8])//����l���e�}����F���ς܂���||����ܕ��@�}����G������
		{
			//�@�y�h�{���_�̓������z�ɂ���	���u���N�G�X�g�p��b�v�ɐڑ�			���u����l���@���k���ɑ��𓥂ݓ��ꂽ�v���߂�����ɏo��
			SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x10 ) )	// 0x10:�N�G�X�g�p�I��������P
		}
	}
	if(( FLAG[GF_QUEST_402] == QUEST_BBS || FLAG[GF_QUEST_402] == QUEST_START ) &&
