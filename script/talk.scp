// �T�n�h�F�N�G�X�g��b
function "Talk_Sahad_Quest"
{
	SetFlag( GF_QS_EVENT_TMP, 0 )	//1:�N�G�X�g�C�x���g����

	//���N�G�X�g�B���O

	// �N�G�X�g���o�^���o�^��̊J�n�O
	if( FLAG[GF_QUEST_300] == QUEST_NOTHING || FLAG[GF_QUEST_300] == QUEST_BBS )
	{
		//������������������������������������������������������������
		//���N�G�X�g�J�n�C�x���g
		//������������������������������������������������������������
		//�@�@���ŏ��̓J�����؂�ւ��Ȃ�
		
		LookChr("this", "LEADER")

		TalkPopup("Sahad",0,0,0,0,0)
		{
			"#000e#000m���H�@�A�h���B"
			"���V�̘b�𕷂��Ă���邩�H"
		}
		WaitPrompt()
		WaitCloseWindow()

		//�@�@��ʈÓ]������ŁA�W�������}�b�v�A�_�ꂩ��̍���������ӂ�̍L��B
		
		FadeOut(FADE_BLACK,FADE_NORMAL)
		WaitFade()
		
		SetFlag( GF_QS_EVENT_TMP, 1 )		//1:�N�G�X�g�C�x���g����
		SetFlag( TF_LOADING_TIPS_OFF, 1 )	//NowLoading ���� Tips �\�����J�b�g
		LoadArg("map/mp1201/mp1201.arg")
		EventCue("mp1201:QS_300_Start")		// �yQS300�z�F��̖؁i�T�n�h�j	���N�G�X�g�J�n�C�x���g
	}
	// �F��̖ؓ����́u���N�G�X�g�B���C�x���g�v�ɐڑ�
	else if( FLAG[GF_QUEST_300] == QUEST_START && FLAG[GF_QS300_GET_TREE] )
	{
		//������������������������������������������������������������
		//���N�G�X�g�B���C�x���g
		//������������������������������������������������������������
		
		LookChr("this", "LEADER")
		
		TalkPopup("Sahad",0,0,0,0,0)
		{
			"#000e#000m�����A�؂�A����̂�"
			"��`���Ă���邩�H"
		}
		WaitPrompt()
		WaitCloseWindow()
		
		SetEnvSEPlayState(-1, 0)	//��SE�S��~
		//�@�@��ʈÓ]�B
		FadeOut(FADE_BLACK,FADE_NORMAL)
		WaitFade()
		
		SetFlag( GF_QS_EVENT_TMP, 1 )		//1:�N�G�X�g�C�x���g����
		SetFlag( TF_LOADING_TIPS_OFF, 1 )	//NowLoading ���� Tips �\�����J�b�g
		LoadArg("map/mp1201/mp1201.arg")
		EventCue("mp1201:QS_300_Complete")		// �yQS300�z�F��̖؁i�T�n�h�j	���N�G�X�g�B���C�x���g
		SetEnvSEPlayState(-1, 0)	//��SE�S��~
	}
	// �u���N�G�X�g�p��b�v
	else
	{
		//������������������������������������������������������������
		//���N�G�X�g�p��b
		//������������������������������������������������������������
		//�@�@���u����O���A�W�����_�����Ɍ������v���̂݃J�����؂�ւ�
		
		if( FLAG[GF_NPC_3_02_GOTO_GENSD] &&			//����O���A�W�����_�����Ɍ�����
			!FLAG[GF_NPC_3_02_OCCUR_INTERCEPT5] &&	//�I����O���e�}����D������
			!FLAG[TF_SAHAD_QS_TALK] )
		{
			//��������������������  ��ʁE�J�n����  ������������������������
			SetFlag( TF_TALK_ZOOMNOINTERPOLATE, 1 )	//ZOOMCAMERA�Ɋւ����ԏ�������u�ŏI��点��
			ResetStopFlag(STOPFLAG_TALK)
			SetStopFlag(STOPFLAG_TALK2)
			//Wait(1)		// �I�������莞�p
			//������������������������������
			//	�ꏊ		�F������i�E���̑�
			//������������������������������
			//	�z�u�E�J�����F����p�^�T�n�h�u����O���A�W�����_�����Ɍ������v
			//				  8.78f	-1419.15f	16.52f	-81.18f
			//	���[�V����	�F�v��
