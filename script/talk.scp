function "Talk_Nia_Quest"
{
	SetFlag( GF_QS_EVENT_TMP, 0 )	//1:�N�G�X�g�C�x���g����

	//���N�G�X�g�B���O

	// �N�G�X�g���o�^���o�^��̊J�n�O
	if( FLAG[GF_QUEST_311] == QUEST_NOTHING || FLAG[GF_QUEST_311] == QUEST_BBS )
	{
		//������������������������������������������������������������
		//���N�G�X�g�J�n�C�x���g
		//������������������������������������������������������������
		//�@�@���ŏ��̓J�����؂�ւ��Ȃ�
		
		LookChr("this", "LEADER")
		
		TalkPopup("Nia",0,0,0,0,0)
		{
			"#000e#000m���A�A�h������B\p "
			"�������̒T���A�����l�ł��B"
			"���́c�c\p"
			"�c�c�������b��"
			"�����Ă��������Ă�낵���ł����H"
		}
		WaitPrompt()
		WaitCloseWindow()
		
		SetEnvSEPlayState(-1, 0)	//��SE�S��~
		
		//�@�@��ʈÓ]������ŁA������i�̍���B
		FadeOut(FADE_BLACK,FADE_NORMAL)
		WaitFade()
		
		SetFlag( GF_QS_EVENT_TMP, 1 )		//1:�N�G�X�g�C�x���g����
		SetFlag( TF_LOADING_TIPS_OFF, 1 )	//NowLoading ���� Tips �\�����J�b�g
		LoadArg("map/mp1201/mp1201.arg")
		EventCue("mp1201:QS_311_Start")		// �yQS311�z�_�ɋF����i�V�X�^�[�E�j�A�j	���N�G�X�g�J�n�C�x���g
	}
	// �u���N�G�X�g�p��b�v
