		//{
		//	TalkPopup("Laxia",0,0,0,0,0)
		//	{
		//		"#000e#000m�c�c�A�h���E�N���X�e�B���A"
		//		"������낵���ł��傤���H"
		//	}
		//	WaitPrompt()
		//	WaitCloseWindow()
		//}
		////	�ˁu�����N�V���Ɠ�l����Řb���v��
		//else
		//{
		//	TalkPopup("Laxia",0,0,0,0,0)
		//	{
		//		"#000e#000m�c�c�A�h���A"
		//		"������낵���ł��傤���H"
		//	}
		//	WaitPrompt()
		//	WaitCloseWindow()
		//}
		////����������������������������������������
		
		TalkPopup("Laxia", 0, 0, 0, 0, 0)
		{
