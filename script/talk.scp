			RollCamera( 0 , 0.0f , 0 )		// ���[����]
			MoveCameraAt( 0 , -11.627f , 12.265f , 1.217f , 0 )	// �����_
			MoveCamera( 0 , -11.192f , 11.726f , 1.326f , 0 )		// ���_
			
