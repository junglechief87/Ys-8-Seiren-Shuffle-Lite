	}
	// �u���N�G�X�g�p��b�v
	else
	{
		//���N�G�X�g�B���O
		
		if( FLAG[GF_NPC_4_01_GOTO_NORTH] &&			//����l���@���k���ɑ��𓥂ݓ��ꂽ
			!FLAG[GF_NPC_4_01_OCCUR_INTERCEPT7] &&	//�I����l���e�}����F������
			!FLAG[GF_NPC_4_02_SEE_THANATOS] &&
			!FLAG[TF_RICOTTA_QS_TALK] )
		{
			//�@�@���u����l���@���k���ɑ��𓥂ݓ��ꂽ�v���̂݃J�����؂�ւ�
			//��������������������  ��ʁE�J�n����  ������������������������
			SetFlag( TF_TALK_ZOOMNOINTERPOLATE, 1 )	//ZOOMCAMERA�Ɋւ����ԏ�������u�ŏI��点��
			ResetStopFlag(STOPFLAG_TALK)
			SetStopFlag(STOPFLAG_TALK2)
			//Wait(1)		// �I�������莞�p
			//������������������������������
			//	�ꏊ		�F������i�E����
			//������������������������������
			//	�z�u�E�J�����F
			//	���[�V����	�F
			//������������������������������
			SaveCamera()
			ChangeCameraPers( 0 , 60.000f , 0 )	// ����p
			SetCameraZPlane( 0.100f , 300.000f )	// ZPlane
			RollCamera( 0 , 0.0f , 0 )		// ���[����]
			MoveCameraAt( 0 , -13.812f , -1513.240f , 9.201f , 0 )	// �����_
			MoveCamera( 0 , -13.344f , -1512.406f , 9.491f , 0 )		// ���_
			
			//�L������������̋L�q
			ChangeSubAnimation("Ricotta",SUBMOT_EYE,ANI_E_ANGER_CLOSE,1)
