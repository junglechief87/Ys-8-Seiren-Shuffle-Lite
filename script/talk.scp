function "Talk_Alison"
{
	//��b���[�v�����t���O�����낷�i���p�b�`1.01�Ή��j
	SetFlag( GF_QS_EVENT_TMP, 0 )				//1:�N�G�X�g�C�x���g����

	// ��b�������`�F�b�N
	SetFlag( TF_TALK_TYPE, 0 )
	if( FLAG[GF_NPC_2_04_JOIN_ALISON] )		//����񕔇C�A���X����������
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x01 ) )	// 0x01:�V���b�v����
	}
	if( ALLITEMWORK[ICON3D_PRESENT_ALISON] &&	//�u���I�Ȑj�v
	//	FLAG[GF_NPC_3_02_GOTO_GENSD] )			// �����^�C�~���O�F����O���A�W�����_�����Ɍ�����
		FLAG[GF_NPC_3_01_GOTO_LAXIA] )			// �����^�C�~���O�F����O���@���N�V���̌��֌�����
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x02 ) )	// 0x02:�v���[���g�A�C�e������
	}
	if (FLAG[GF_QUEST_222] == QUEST_BBS || FLAG[GF_QUEST_222] == QUEST_START)	// �yQS222�z�d���Ă̗��K�i�A���X���j �N�G�X�g�B�����s�O
	{
		//�u����񕔇G�J�g���[�����������v���߂�����
		if (FLAG[GF_NPC_2_09_CHECK_LOOKOUT])
		{
			//�@�y�d���Ă̗��K�z�ɂ���		���u���N�G�X�g�p��b�v�ɐڑ�			���u����񕔇G�J�g���[�����������v���߂�����ɏo��
			SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x10 ) )	// 0x10:�N�G�X�g�p�I��������P
		}
	}
	if(( FLAG[GF_QUEST_222] == QUEST_BBS || FLAG[GF_QUEST_222] == QUEST_START ) &&
		 ALLITEMWORK[ICON3D_MT_N2_LEATHER] >= 3 )	// �yQS222�z�d���Ă̗��K�i�A���X���j �u��������v�~�R�������Ă���
	{
		//�@�w��������x�~�R��n��		���u���N�G�X�g�B���C�x���g�v�ɐڑ�		���f�����m�F�A���f�ނ������Ă���Əo��
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x20 ) )	// 0x20:�N�G�X�g�p�I��������Q
	}
	
	// ��b�����̎������`�F�b�N
	if( FLAG[GF_QS510_LOOK_SUBEV] &&			// �yQS510�z���T�u�C�x���g�E�A���X�����|��� ��������
		FLAG[GF_QUEST_510] < QUEST_FALSE )		// �yQS510�z�̋��̉� �N�G�X�g�B�����s�O
	{
		// �ܕ��̐Q���ރ^�C�~���O�ł͈ꎞ�I�Ƀv���[���g�̑I����������
		if( FLAG[TF_TALK_TYPE] & 0x02 )	// 0x02:�v���[���g�A�C�e������
		{
			SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] - 0x02 ) )	// 0x02:�v���[���g�A�C�e�������������
		}
	}

