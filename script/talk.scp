		( FLAG[GF_02MP1111_WOUND_BARBAROSS] && !FLAG[GF_03MP6410M_HEAR_TREE] )||	// �o���o���X���v�����𕉂��`�I�_�[�i�҇@	�A���Ղ̐������󂯂�
		( FLAG[GF_NPC_4_02_SEE_THANATOS] && !FLAG[GF_NPC_5_01_BEFORE_INTERCEPT8] && FLAG[TF_MP6409_NOW] )||	// ����l���A�^�i�g�X�Əo������`�I����ܕ��@�}����G������	���Amp6409�ɂ����
		( FLAG[GF_NPC_5_02_GOTO_LOOKOUT] && !FLAG[GF_NPC_5_03_GOTO_GHOSTHIP] )||	// ����ܕ��������Ɍ������`�I����ܕ��B�H��D�𒲂ׂɌ�����
		( FLAG[GF_NPC_5_06_HOLD_PARTY] && !FLAG[GF_NPC_5_07_GOTO_VALLAY] )||		// ����ܕ��E���̕Y�������U��i��j�`�I����ܕ��F���Ƃ̒J�֌�����
