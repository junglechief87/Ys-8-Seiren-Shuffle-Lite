		//LoadArg("map/mp1201/mp1201.arg")
		EventCue("mp1201:QS_610_Start")		// �yQS610�z�e�F�̈⌾�i�_�[�i�j	���N�G�X�g�J�n�C�x���g
	}
	//���N�G�X�g�B���O
	else
	{
		if( !FLAG[TF_DANA_QS_TALK] )
		{
			//��������������������  ��ʁE�J�n����  ������������������������
			SetFlag( TF_TALK_ZOOMNOINTERPOLATE, 1 )	//ZOOMCAMERA�Ɋւ����ԏ�������u�ŏI��点��
			ResetStopFlag(STOPFLAG_TALK)
			SetStopFlag(STOPFLAG_TALK2)
			//Wait(1)		// �I�������莞�p
			//������������������������������
			//	�ꏊ		�F������i�E����
			//������������������������������
			//	�z�u�E�J�����F�_�[�i�ړ��`�i����j
