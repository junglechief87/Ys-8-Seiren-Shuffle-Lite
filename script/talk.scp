// ����b�o���o���X�D��
function "Talk_Barbaross"
{
	//��b���[�v�����t���O�����낷�i���p�b�`1.01�Ή��j
	SetFlag( GF_QS_EVENT_TMP, 0 )				//1:�N�G�X�g�C�x���g����

	// ��b�������`�F�b�N
	SetFlag( TF_TALK_TYPE, 0 )
	if( FLAG[GF_NPC_1_02_MEET_BARBAROSS] &&		//����ꕔ�A�o���o���X�D���ƍ�������
		FLAG[GF_01MP1101_DRAW_MAP] &&			// �n�}��`����
		!FLAG[GF_SPEEDRUN_MAP_COMP] )			// ��荞�ݒn�}���j���񍐁F�n�}���j���P�O�O���̕񍐂�����
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x01 ) )	// 0x01:��荞�ݗp�I��������
	}
	if( FLAG[GF_QUEST_200] == QUEST_BBS || FLAG[GF_QUEST_200] == QUEST_START )	// �yQS200�z�x�b�h�̍쐬�i�o���o���X�j
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x10 ) )	// 0x10:�N�G�X�g�p�I��������P
	}
	if( FLAG[GF_QUEST_220] == QUEST_BBS || FLAG[GF_QUEST_220] == QUEST_START )	// �yQS220�z�������̍쐬�i�o���o���X���K�{�j
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x20 ) )	// 0x20:�N�G�X�g�p�I��������Q
	}
	if( FLAG[GF_QUEST_223] == QUEST_BBS || FLAG[GF_QUEST_223] == QUEST_START )	// �yQS223�z�q���b�p�[�̑|��
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x40 ) )	// 0x40:�N�G�X�g�p�I��������R
	}

////////////////////////////////////////////////////
// �o���o���X�F�T�u�C�x���g
//
	if( FLAG[GF_02MP1201_START_HEARING] &&		// �������݂��J�n����
		!FLAG[GF_SUBEV_NEMO_TALK_BARBAROSS] )	// �������ɂ��ăo���o���X�D���Ƙb����
 	{
 		EventCue("mp1201:SubEV_02_Talk_Barbaross")	//	�y�������̕������݁F�o���o���X�z
	}
	
	// ����`���[�g���A���C�x���g
	else if ( FLAG[GF_NPC_1_02_MEET_BARBAROSS] &&	//����ꕔ�A�o���o���X�D���ƍ�������
		 !FLAG[GF_02MP1202_GET_CLOTHES] &&		//����񕔂O�`���[�g���A����
		 !FLAG[GF_HELP_A11]) 					//�� help_a11�F����
	{
			EventCue("mp1201:SubEV_Help_Medicine")
	}
////////////////////////////////////////////////////
// ��b�I�������o�Ȃ��^�C�~���O
//	�E����񕔇K�J�[�������̔ߖ𕷂����@�̃^�C�~���O
//	�E����񕔇Q�o���o���X���v�����𕉂����i�l�Ӂj�̃^�C�~���O
//	�E�u������Ń_�[�i�ɏo�(mpXXXX)�v�̃^�C�~���O
//	�E����ܕ��������Ɍ������@�̃^�C�~���O
//	�E����ܕ��E���̕Y�������U��i��j�@�̃^�C�~���O
//	�E�G�s���[�O�ȍ~
	else if( ( FLAG[GF_02MP1202_HEAR_SHOUT] && !FLAG[GF_02MP1201_BEFORE_INTERCEPT2] )||	// ���ѐ��𕷂����`�I�}����̏������͂��߂�
		( FLAG[GF_02MP1111_WOUND_BARBAROSS] && !FLAG[GF_03MP6410M_HEAR_TREE] )||	// �o���o���X���v�����𕉂��`�I�_�[�i�҇@	�A���Ղ̐������󂯂�
