function "Talk_Dogi_Quest1"
{
	SetFlag( GF_QS_EVENT_TMP, 0 )	//1:�N�G�X�g�C�x���g����

	//�N�G�X�g�J�n�O
	if( FLAG[GF_QUEST_201] == QUEST_BBS )
	{
		//������������������������������������������������������������
		//���N�G�X�g�J�n�C�x���g
		//������������������������������������������������������������
		//�@�@���ŏ��̓J�����؂�ւ��Ȃ�
		
		LookChr("this", "LEADER")
		
		TalkPopup("Dogi",0,0,0,0,0)
		{
			"#000e#000m���A�˗����󂯂Ă����̂��H\p"
			"���񂶂�A���߂Đ��������Ă��炤���B"
		}
		WaitPrompt()
		WaitCloseWindow()
		
		//�@�@��ʈÓ]������ŁA�q�ɑO�B
		
		FadeOut(FADE_BLACK,FADE_NORMAL)
		WaitFade()
		
		SetFlag( GF_QS_EVENT_TMP, 1 )		//1:�N�G�X�g�C�x���g����
		SetFlag( TF_LOADING_TIPS_OFF, 1 )	//NowLoading ���� Tips �\�����J�b�g
		if(FLAG[GF_02MP1202_GET_CLOTHES] && !FLAG[GF_02MP1201_TAKE_BREAKFAST]		//�h�M���������������
			 || FLAG[GF_02MP1201_LOST_CURRAN] && !FLAG[GF_02MP1201_LOOK_CURRAN]		//�J�[�����𔭌�����
			 || FLAG[GF_02MP1201_START_HEARING] && !FLAG[GF_02MP1201_LOOK_MAN]		//�T�n�h���l�e�𔭌�����
			 || FLAG[GF_03MP1202_AWAKE_ADOL] && !FLAG[GF_03MP1201_GOTO_GENSD]		//�W�����_�����֌��������ƂɂȂ�
			 || FLAG[GF_07MP1201_CHECK_VILLAGE] )									//�d�c�V �s�͂��܂�̐[���t�˔j
		{
			LoadArg("map/mp1201t3/mp1201t3.arg")
		}
		else
		{
			LoadArg("map/mp1201/mp1201.arg")
		}
		EventCue("mp1201:QS_201_Start")		// �yQS201�z���~�p�̑f�ށi�h�M�j	���N�G�X�g�J�n�C�x���g
	}
	//�N�G�X�g��
	else
	{
		//������������������������������������������������������������
		//���N�G�X�g�p��b
		//������������������������������������������������������������
		//�@�@���J�����؂�ւ��Ȃ�
		
		LookChr("this", "LEADER")
		
		//��������������������������������������������
		//	�ˁw�y�����x�~�W�^�w�������S�t�x�~�P�Q�������Ă���
		if( ALLITEMWORK[ICON3D_MT_N1_BONE] >= 8 &&		//�u�y�����v
		    ALLITEMWORK[ICON3D_MT_N1_LIQUID] >= 12 )		//�u�������S�t�v
		{
			TalkPopup("Dogi",0,0,0,0,0)
			{
				"#000e#000m���A�ǂ���痊��ł��f�ނ�"
				"�W�܂����悤���ȁB"
			}
			WaitPrompt()
			WaitCloseWindow()
			
			//�I����
