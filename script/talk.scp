function "QUEST_401_POS"	//�yQS401�z�V����͂������Ŕz�u�����s�b�J�[�h�𕜋A����
{
	if(FLAG[GF_QUEST_401] == QUEST_START )
	{
		if (!FLAG[GF_QS401_LOOK_PICARD_1]){
			LoadChr("ev_QS_401_Picard_1")
			SetChrPos("ev_QS_401_Picard_1", 5.39f, -1494.67f, 1.75f)
			Turn("ev_QS_401_Picard_1", -137.28f, 360.0f)
		}
		else if (FLAG[GF_QS401_LOOK_PICARD_1] && !FLAG[GF_QS401_LOOK_PICARD_2]){
			LoadChr("ev_QS_401_Picard")
			SetChrPos("ev_QS_401_Picard", 21.48f, -1428.50f, 17.89f)
			Turn("ev_QS_401_Picard", -108.14f, 360.0f)
		}
		else if (FLAG[GF_QS401_LOOK_PICARD_A] && FLAG[GF_QS401_LOOK_PICARD_B] ){
			LoadChr("ev_QS_401_Picard_C")
			SetChrPos("ev_QS_401_Picard_C", -10.46f, -1382.01f, 13.62f)
			Turn("ev_QS_401_Picard_C", -96.52f, 360.0f)
		}
		else
		{
			LoadChr("ev_QS_401_Picard_C")
		}
	}
}

