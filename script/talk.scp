function "Talk_Aaron_Thanatos_6_02"
{
	//����Z���A�W�����_��������֌�����
	//��������������������  ��ʁE�J�n����  ������������������������
	SetFlag( TF_TALK_ZOOMNOINTERPOLATE, 1 )	//ZOOMCAMERA�Ɋւ����ԏ�������u�ŏI��点��
	ResetStopFlag(STOPFLAG_TALK)
	SetStopFlag(STOPFLAG_TALK2)
	//Wait(1)		// �I�������莞�p
	//������������������������������
	//	�ꏊ		�F�������i�E�H�|��
	//������������������������������
	//	�z�u�E�J�����F�G�A������{�b�i�����z�u�j
	//				  �G�A�����E�^�i�g�X�Řb��
	//	���[�V����	�F
	//������������������������������
	SaveCamera()											//���p�b�`1.02�C��
	ChangeCameraPers( 0 , 60.000f , 0 )	// ����p
	SetCameraZPlane( 0.100f , 300.000f )	// ZPlane
	RollCamera( 0 , 0.0f , 0 )		// ���[����]
	MoveCameraAt( 0 , 17.242f , -1422.571f , 13.149f , 0 )	// �����_
	MoveCamera( 0 , 18.442f , -1422.554f , 13.192f , 0 )		// ���_
	// ResetCameraZPlane()	// �C�x���g�I�����ɌĂяo���ĉ������B�}�b�v���̐ݒ�ɖ߂��܂��B
	
	//�L������������̋L�q
	LookSpd("Aaron", 1.0f, 1.0f, 1.0f)
	LookSpd("Thanatos", 1.0f, 1.0f, 1.0f)
	LookChr( "Aaron" , "Thanatos" )
	LookChr( "Thanatos" , "Aaron" )
	CallFunc("system:talkevent_begin")		//TALK_BEGIN
	SetChrWork("Aaron", CWK_SCRIPTPAUSE, 1)
	SetChrWork("Aaron", CWK_DEFAULT_SKIPNODE_OFF, 1)
	SetChrWork("Thanatos", CWK_SCRIPTPAUSE, 1)
	SetChrWork("Thanatos", CWK_DEFAULT_SKIPNODE_OFF, 1)
		
	LookSpd("Aaron", LOOKSPD_DEFAULT, LOOKSPD_DEFAULT, LOOKSPD_DEFAULT)
	LookSpd("Thanatos", LOOKSPD_DEFAULT, LOOKSPD_DEFAULT, LOOKSPD_DEFAULT)
	//��������������������������������������������������������������

	//�@�@�U������Ȃ�
	ChangeAnimation( "Aaron", "ANI_EV_YARUKI_S", -1, 1 )	// ���Ԃ�����������
	
	TalkPopup("Aaron",0,0,0,0,0)
	{
		"#031e#000m�N�\�b�A�܂����Ñ��ǂ���"
		"�P���Ă��邩�����������񂶂�˂����B\p"
		"#032e#000m�����ꂳ��A������͂˂��̂��@�H"
		"������4�s��"
	}
	WaitPrompt()
	WaitCloseWindow()
	
	ChangeAnimation( "Aaron", "ANI_EV_YARUKI_E", -1, 1 )	// ���Ԃ�����������
	Wait(10)
	ChangeAnimation( "Thanatos", "ANI_EV_SIAN_S", -1, 1 )	// �v��

	TalkPopup("Thanatos",0,0,0,0,0)
	{
		"#011e#000m�d���Ȃ��A�A�����g�����c�c\p"
		"#012e�킵�������̃s���`����"
		"�~���Ă������ɂ̔錍�A�Y�o������"
	}
	WaitPrompt()
	WaitCloseWindow()
	
	ChangeAnimation( "Thanatos", "ANI_EV_SIAN_E", -1, 1 )	// �v��
	
	TalkPopup("Thanatos",0,0,0,0,0)
	{
		"#020e#220m���[���A�����A���[���A�I"
		"����Ȏ������]�T��������ƂȁI"
	}
	WaitPrompt()
	WaitCloseWindow()

	//�@�@�G�A�����ɗ�⊾�G���[�V����
	EmotionEx("Aaron", 0.00f, EMO_TARA, 0, 5, 1, 1, 1.0f)	//��⊾
	Wait(30)
	ChangeAnimation( "Aaron", "ANI_EV_BORI", -1, 1 )	// ������

	TalkPopup("Aaron",0,0,0,0,0)
	{
		"#051e#000m���[�A�����������n�����������@�H"
	}
	WaitPrompt()
	WaitCloseWindow()

	SetFlag( TF_AARON_TALK, 1 )
	SetFlag( TF_THANATOS_TALK, 1 )
	CallFunc("system:talkevent_end")		//TALK_END
	SetStopFlag(STOPFLAG_TALK)
	SetFlag( TF_TALK_ZOOMNOINTERPOLATE, 1 )	//ZOOMCAMERA�Ɋւ����ԏ�������u�ŏI��点��
	CallFunc("system:talk_begin_zoom")		//TALK_ZOOM
	LookChr( "Aaron" , "Thanatos" )
	LookChr( "Thanatos" , "Aaron" )
}

