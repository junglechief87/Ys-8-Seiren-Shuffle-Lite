			if( ( FLAG[GF_NPC_2_11_JOIN_DINA] && !FLAG[GF_NPC_2_11_AFTER_INTERCEPT3] &&		!FLAG[GF_02MP2301_JOIN_AARON] )||	//����񕔇J�f�B�i���������@&&�@���G�A��������O
				( FLAG[GF_NPC_2_10_JOIN_HUMMEL] && !FLAG[GF_NPC_2_10_AFTER_INTERCEPT2] &&	!FLAG[TF_KIERGAARD_TALK] )||		//����񕔇I�q�������������ԂɂȂ����@&& �����b
				( FLAG[GF_NPC_2_07_AFTER_INTERCEPT] && !FLAG[GF_NPC_2_08_JOIN_KATRIN] &&	!FLAG[TF_KIERGAARD_TALK] ) )		//����񕔇F�}����@���ς܂����@&& �����b
			{
				//����񕔇J�f�B�i���������@�́@���G�A��������O�@�͐U������Ȃ�
				//����񕔇I�q�������������ԂɂȂ����@�����b�@�͐U������Ȃ�
				//����񕔇F�}����@���ς܂����@�����b�@�͐U������Ȃ�
			}
			else
			{
				LookChr("this", "LEADER")
			}
			
			// �I�����쐬
			MenuReset()
			MenuAdd( 0 , "�b������")
			if( FLAG[TF_TALK_TYPE] & 0x01 )	// �V���b�v����
			{
				MenuAdd( 1 , "���򂷂�" )
			}
			MenuAdd( -1, "��߂�9")
			MenuType(MENUTYPE_POPUP)
			MenuOpen( TF_MENU_SELECT, -1, 200, -1, -2, 10, 1 )		//��ʉ�b�p�ݒ�
			WaitMenu(0)
			MenuClose(10,0)
			
			if (FLAG[TF_MENU_SELECT] == 0)	// �b��
			{
				// ��b����
				LookReset( "this" )
				CallFunc( "talk:Talk_Kiergaard2" )
