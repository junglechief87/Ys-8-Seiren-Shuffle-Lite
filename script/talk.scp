function "Talk_Speedrun_Thanatos"
{
	//���C���̃����𑵂��ă^�i�g�X�ɓn��
	//�@�@�C���̃����@�`�E�������Ă����Ԃ�
	//�@�@�^�i�g�X�ɘb��������ƈȉ��̏����B
	//�@�@�J�������Ƃ�Ȃ���ʉ�b�����ōs���B

	SetStopFlag(STOPFLAG_TALK)
	CallFunc("system:talk_begin_zoom")		//TALK_ZOOM
	
	LookChr("this", "LEADER")

	//�@�@�^�i�g�X�ɂo�`�G���[�V����
	EmotionEx("Thanatos", 0.00f, EMO_PA, 0, 5, 1, 1, 1.0f)	//�p�b
	Wait(50)

	TalkPopup("Thanatos",0,0,0,0,0)
	{
		"#000e#000m����H�@�A�h����B"
		"�C���̃����������Ă���悤����ȁB\p"
		"���V���ȑO�A�C���̑�����"
		"���ׂĂ������������ĂȁB\p"
		"����͎Q�l�ɂȂ肻������B"
