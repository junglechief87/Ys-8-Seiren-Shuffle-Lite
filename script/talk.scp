			CallFunc("system:default_Shake_set")	// �f�t�H���g�̗h��ɂ���
			}
			else
			{
				//�@�@���J��Ԃ�
				//�@�@���J�����؂�ւ��Ȃ�
				LookChr("this", "LEADER")
			
				TalkPopup("Kashu",0,0,0,0,0)
				{
					"#000e#000m�o���o���X�D����"
					"�A�h����T���Ă����݂��������B\p"
					"�s�D�����t�ɍs���Ă݂���ǂ������H"
				}
				WaitPrompt()
				WaitCloseWindow()
			}
		}
	}
	else if( FLAG[GF_NPC_0_01_GO_CAPTAINROOM] )		//�����@�o���o���X�D���̏��֌�����
	{
		//�����@�o���o���X�D���̏��֌�����
