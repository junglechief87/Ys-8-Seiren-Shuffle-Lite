	}
	if(( FLAG[GF_QUEST_602] == QUEST_BBS || FLAG[GF_QUEST_602] == QUEST_START ) &&	//�yQS602�z�����̒��B�i�J�V���[�j
		FLAG[GF_NPC_6_03_OCCUR_INTERCEPT12])		// ����Z���e�}����K�������i�Z�����̉�������j
