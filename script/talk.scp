function "Talk_Speedrun_Aaron"
{
	//���G�A�����́u�n�}��������v�p����

	LookChr("this", "LEADER")

	CallFunc("rng:mapRewardPreview")

	if (rand() % 100 < 50)
	{
		PlayVoice(Y8V_3841,"Aaron",100)	//���񂶂ጩ���Ă��炤���B
		TalkPopup("Aaron",0,0,0,0,0)
		{
			"#000e#000m���񂶂ጩ���Ă��炤���B"
		}
		WaitPrompt()
		WaitCloseWindow()
	} else {
		PlayVoice(Y8V_3842,"Aaron",100)	//�����A�ǂ�ǂ�c
		TalkPopup("Aaron",0,0,0,0,0)
		{
			"#000e#000m�����A�ǂ�ǂ�c�c"
		}
		WaitPrompt()
		WaitCloseWindow()
	}

	//	WK_MAPRATIO - �n�}�̓��j���i1000��100%�j
	SetFlag( GF_QS_EVENT_TMP, 0 )	//1:�C�x���g�����i�I�����𔲂���j

	//�񍐏o���邩�̃`�F�b�N	//if������������ƃG���[���o�Ă��܂��̂ŁA�������Ă���܂�
	SetFlag(TF_MENU_SELECT,0)
	if( ( WORK[WK_MAPRATIO] < 200  && FLAG[GF_SPEEDRUN_MAP_10P] )||	// 10%�`20�������łP�O���A�C�e�������Ă���
		( WORK[WK_MAPRATIO] < 300  && FLAG[GF_SPEEDRUN_MAP_20P] )||	// 20%�`30�������łQ�O���A�C�e�������Ă���
		( WORK[WK_MAPRATIO] < 400  && FLAG[GF_SPEEDRUN_MAP_30P] )||	// 30%�`40�������łR�O���A�C�e�������Ă���
		( WORK[WK_MAPRATIO] < 500  && FLAG[GF_SPEEDRUN_MAP_40P] ))	// 40%�`50�������łS�O���A�C�e�������Ă���
	{
		SetFlag(TF_MENU_SELECT,1)	//�񍐏o���Ȃ�
	}
	else if(( WORK[WK_MAPRATIO] < 600  && FLAG[GF_SPEEDRUN_MAP_50P] )||	// 50%�`60�������łT�O���A�C�e�������Ă���
			( WORK[WK_MAPRATIO] < 700  && FLAG[GF_SPEEDRUN_MAP_60P] )||	// 60%�`70�������łU�O���A�C�e�������Ă���
			( WORK[WK_MAPRATIO] < 800  && FLAG[GF_SPEEDRUN_MAP_70P] ) )	// 70%�`80�������łV�O���A�C�e�������Ă���
	{
		SetFlag(TF_MENU_SELECT,1)	//�񍐏o���Ȃ�
	}
	else if(( WORK[WK_MAPRATIO] < 900  && FLAG[GF_SPEEDRUN_MAP_80P] )||	// 80%�`90�������łW�O���A�C�e�������Ă���
			( WORK[WK_MAPRATIO] < 1000 && FLAG[GF_SPEEDRUN_MAP_90P] ))	// 90%�`100�������łX�O���A�C�e�������Ă���
	{
		SetFlag(TF_MENU_SELECT,1)	//�񍐏o���Ȃ�
	}

	//��������������������������������������������������
	//	�˕񍐂��o���Ȃ��ꍇ
	if( WORK[WK_MAPRATIO] < 100 ||	// 10������
		FLAG[TF_MENU_SELECT] == 1 )
	{
		//	  �@�G�A�����Ɂu�c�v�G���[�V�����B
		EmotionEx("Aaron", 0.00f, EMO_3DOT, 0, 5, 1, 1, 1.5f)	//�c
		Wait(60)

		PlayVoice(Y8V_3845,"Aaron",100)	//�債�Đi��ł˂�����˂���
		TalkPopup("Aaron",0,0,0,0,0)
		{
			"#000e#000m�債�Đi��ł˂�����˂����B\p"
			"�킴�킴��������Ă�Ȃ�A"
			"�������Ɛ��ʂ��グ�Ă���񂾂ȁB"
		}
		WaitPrompt()
		WaitCloseWindow()
		
		//	  �@��b�I���B
	}
	//	�˕񍐂��o����ꍇ
	else
	{
		//	  �@���̂܂܈ȉ��̗���B
		SetFlag( GF_QS_EVENT_TMP, 1 )	//1:�C�x���g�����i�I�����𔲂���j
		
		ResetStopFlag(STOPFLAG_TALK)
		CallFunc( "talk:Speedrun_Aaron" )
	}
	//��������������������������������������������������
}
function "Speedrun_Aaron"
{
	//	  �@�����Ńo�X�g�V���b�g�C�x���g���N���B

//�o�X�g�V���b�g������������-----------------------------------------------

	CallFunc("system:bokeevent_begin")		//�ڂ����C�x���g

	SaveEventState()
	SaveCamera()

	ResetMotion("Aaron" , 1 )
	LookSpd("Aaron", 1.0f, 1.0f, 1.0f)
	LookReset( "Aaron" )

	CallFunc("system:party_reset")
	ResetChrPos((CHRTYPE_NPC | REMOVE_POS))

	//�C���t�H�t���O�A�L�������[�N
	SetChrInfoFlag( "ADOL" , INFOFLAG_NOGRAVITY )
	SetChrInfoFlag( "ADOL" , INFOFLAG_NOCHRATARI)
	SetChrInfoFlag( "ADOL" , INFOFLAG_NOMAPATARICHECK )
	SetChrInfoFlag( "Aaron" , INFOFLAG_NOGRAVITY )
	SetChrInfoFlag( "Aaron" , INFOFLAG_NOCHRATARI)
	SetChrInfoFlag( "Aaron" , INFOFLAG_NOMAPATARICHECK )
	SetChrWork("ADOL", CWK_DEFAULT_SKIPNODE_OFF, 1)
	SetChrWork("Aaron", CWK_DEFAULT_SKIPNODE_OFF, 1)

	//�L�����ʒu�͌��_
	SetChrPos("Aaron",0.00f,0.00f,0.00f)
	Turn("Aaron",28.89f,360.0f)
	LookTo("Aaron", -0.250f , -3.120f , 1.470f )
	LookSpd("Aaron", 1.0f, 1.0f, 1.0f)

	//�������[�V����
	ChangeAnimation( "Aaron" , "ANI_WAIT", -1 , 1 )	//�֎q�ɍ����Ă邱�Ƃ�����̂Œʏ��Ԃɖ߂��Ă��܂�
	ChangeSubAnimation("Aaron",SUBMOT_EYE,ANI_E_WAIT,1)
	ChangeSubAnimation("Aaron",SUBMOT_MOUTH,ANI_M_WAIT,1)
	ChangeSubAnimation("Aaron",SUBMOT_EXT1,ANI_E_LOOKC,1)

	//�J�����ʒu�i�L�����̑傫���ɂ���Ē������Ă��������j
	MoveCameraAt( 0 , -0.250f , -0.890f , 1.488f , 0 )	// �����_
	ChangeCameraDistance( 0 , 2.230f , 0 )		// ��{����
	ChangeCameraElevation( 0 , -0.448f , 0 )	// ��{�p
	RotateCamera( 0 , 0.000f , 0 )				// �p�x					//�p�x�͕K��0
	ChangeCameraPers( 0 , 25.000f , 0 )			// ����p
	SetCameraZPlane( 0.100f , 300.000f )			// ZPlane
	RollCamera( 0 , 0.0f , 0 )				// ���[����]
	// ResetCameraZPlane()	// �C�x���g�I�����ɌĂяo���ĉ������B�}�b�v���̐ݒ�ɖ߂��܂��B

	// ��ʊE�[�x�̐ݒ�
	SetDoF(0, LERP_LINEAR, 0.000, 0.100 ,0.000 ,0.000 ,0.000)

	// �O���A�̐ݒ�
	SetGlare(0, LERP_LINEAR, 0.500, 1.300 ,0.500 ,1.000 ,0.600 ,0.000 ,1.000)

	//�V���h�E����
	SetShadowOffset( -10000 )

	Wait(1)	//LookSpd�����҂�
	LookSpd("Aaron", LOOKSPD_DEFAULT, LOOKSPD_DEFAULT, LOOKSPD_DEFAULT)

//�o�X�g�V���b�g���������܂�-----------------------------------------------

	Wait(30)

	ChangeAnimation( "Aaron" , "ANI_EV_RYOTEKOSI_S", -1 , 1 )

	if (rand() % 100 < 50)
	{
		PlayVoice(Y8V_3843,"Aaron",100)	//�ق��A�悭������ȁI
