					( FLAG[GF_NPC_0_02_START_PATROL] && !FLAG[GF_NPC_0_03_ATTACK_SHIP] ) )											//�����A�D�������񂷂�i��j
			{
				//	����Z���@�}����J�������@�����b�@�͐U������Ȃ�
				//����ܕ��G�_�[�i�ƍ�������@�����b�@�͐U������Ȃ�
				//����ܕ��F���Ƃ̒J�֌������@�����b�@�͐U������Ȃ�
