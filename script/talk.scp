function "Talk_Licht"
{
	//��b���[�v�����t���O�����낷�i���p�b�`1.01�Ή��j
	SetFlag( GF_QS_EVENT_TMP, 0 )				//1:�N�G�X�g�C�x���g����

	// ��b�������`�F�b�N
	SetFlag( TF_TALK_TYPE, 0 )
	if (FLAG[DF_JOIN_LICHT])                                 //( FLAG[GF_1STTALK_3_01_LICHT] || FLAG[GF_NPC_3_02_GOTO_GENSD])	//����O���@���N�V���̌��֌������@�f�e����ȍ~���q�g�ɘb��������Ɛf�Ï��V���b�v���J��  �������́A����O���A�W�����_�����Ɍ������ȍ~
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x01 ) )	// 0x01:�V���b�v����
		
		CallFunc("talk:Speedrun_Kiergaard_Calc")	// TF_MENU_SELECT�Ɏ����Ă��钲�����̐�������i�L���S�[���p�̏����𗘗p�j
		if( FLAG[TF_MENU_SELECT] > 0 )	// �������������Ă���
		{
			SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x100 ) )	// 0x100:��������n����
		}
	}
	if( ALLITEMWORK[ICON3D_PRESENT_LICHT] &&	//�u�Âт����f��v
		FLAG[GF_NPC_5_04_GOTO_HOLLOW] )			// �����^�C�~���O�F����ܕ��C��󓴂֌�����
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x02 ) )	// 0x02:�v���[���g�A�C�e������
	}
	if(( FLAG[GF_QUEST_301] == QUEST_BBS || FLAG[GF_QUEST_301] == QUEST_START ) &&
		(FLAG[GF_NPC_3_02_AFTER_INTERCEPT5] || FLAG[GF_NPC_3_03_JOIN_RICOTTA]))	//����O���e�}����D������		 
	{
		//�u����O���A�W�����_�����Ɍ������v���߂�����
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x10 ) )	// 0x10:�N�G�X�g�p�I��������P
	}
	if(( FLAG[GF_QUEST_301] == QUEST_BBS || FLAG[GF_QUEST_301] == QUEST_START ) &&
		 ALLITEMWORK[ICON3D_MT_N3_LIQUID] >= 1 &&	// �yQS301�z�V������̒����i���q�g�j �w�����S�t�x�~�P�������Ă���
		 ALLITEMWORK[ICON3D_MT_N3_FLOWER] >= 1 )	// �yQS301�z�V������̒����i���q�g�j �w�P���t�x�~�P�������Ă���
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x20 ) )	// 0x20:�N�G�X�g�p�I��������Q
	}
	if( FLAG[GF_QUEST_505] == QUEST_BBS || FLAG[GF_QUEST_505] == QUEST_START )	//�yQS505�z�������̍̎�
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x40 ) )	// 0x40:�N�G�X�g�p�I��������R
	}
	
////////////////////////////////////////////////////
// ���q�g�F�T�u�C�x���g
//
	if( FLAG[GF_02MP1201_START_HEARING] &&		// �������݂��J�n����
		!FLAG[GF_SUBEV_NEMO_TALK_LICHT] )		// �������ɂ��ă��q�g�Ƙb����
	{
		EventCue("mp1201:SubEV_02_Talk_Licht")	//�y�������̕������݁F���q�g�z
	}
