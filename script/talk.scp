function "Talk_Ricotta_Quest"
{
	SetFlag( GF_QS_EVENT_TMP, 0 )	//1:�N�G�X�g�C�x���g����

	// �N�G�X�g���o�^���o�^��̊J�n�O
	if( FLAG[GF_QUEST_400] == QUEST_NOTHING || FLAG[GF_QUEST_400] == QUEST_BBS )
	{
		//������������������������������������������������������������
		//���N�G�X�g�J�n�C�x���g
		//������������������������������������������������������������
		//�@�@���ŏ��̓J�����؂�ւ��Ȃ�
		LookChr("this", "LEADER")
		
		//��������������������������������������������
		//	�ˁuGF_04MP6101_MAKE_CAMP�v�������Ă��遁���R�b�^���A�h���Z�ƌĂ�
		if( FLAG[GF_04MP6101_MAKE_CAMP] )
