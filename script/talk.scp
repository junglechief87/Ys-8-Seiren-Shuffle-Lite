// �L���S�[���F��荞��
function "Talk_Speedrun_Kiergaard"
{
	//���L���S�[���ɒ�������n�������̃��b�Z�[�W

	SetStopFlag(STOPFLAG_TALK)
	CallFunc("system:talk_begin_zoom")		//TALK_ZOOM

	//�@�@�S���łP�O�킠�钲�������ǂꂩ��ł������Ă���ꍇ��
	//�@�@�L���S�[���ɘb��������ƃJ�����؂�ւ����s�킸��
	//�@�@�ȉ��̃��b�Z�[�W���N���B
	//�@�@���������͑S�Ėv������B

	LookChr("this", "LEADER")

