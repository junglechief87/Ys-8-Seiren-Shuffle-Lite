			"#012e�����ɂ���Ƃ͌���ʁB"
			"�������߂āc�c���߂�"
			"�w���j�G���x�������ĎQ��̂��B\p"
			//"#2C#250I���j�G��#0C�������ĎQ��̂��B\p"
