	//LookSpd("this", LOOKSPD_DEFAULT, LOOKSPD_DEFAULT, LOOKSPD_DEFAULT)
	//��������������������������������������������������������������

	//�@�@�U������Ȃ�


	PlayVoice(Y8V_5249,"Paro",100)	//���b�z�[�I

	TalkPopup("Paro",0,0,0,0,0)
	{
		"#000e#000m#5C���b�z�[�A���b�z�[�I"
	}
	WaitPrompt()
	WaitCloseWindow()

	//	�n�V�r���R�E
	TalkPopup("Rex",0,0,0,0,0)
	{
		"#0L�c�c�c�c�c�c�c�c�c�c"
	}
	WaitPrompt()
	WaitCloseWindow()

	TalkPopup("Paro",0,0,0,0,0)
	{
		"#000e#000m#5C�Q���L�J�A�Q���L�J�H"
	}
	WaitPrompt()
	WaitCloseWindow()

	//	�n�V�r���R�E
	TalkPopup("Rex",0,0,0,0,0)
	{
		"#000e#000m�c�c�c�c�c�c�c�O�@�c�c"
	}
	WaitPrompt()
	WaitCloseWindow()

