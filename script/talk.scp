// �o���o���X�D���F��荞��
function "Talk_Speedrun_Barbaross"
{
	//���o���o���X�́u�n�}��������v�p����

	LookChr("this", "LEADER")

	if (rand() % 100 < 50)
	{
		PlayVoice(Y8V_3706,"Barbaross",100)	//�ł͌����Ă��炨��
		TalkPopup("Barbaross",0,0,0,0,0)
		{
			"#000e#000m�ł͌����Ă��炨���B"
		}
		WaitPrompt()
		WaitCloseWindow()

	} else {
		PlayVoice(Y8V_3707,"Barbaross",100)	//�ӂށA�ǂ�ǂ�c
		TalkPopup("Barbaross",0,0,0,0,0)
		{
			"#000e#000m�ӂށA�ǂ�ǂ�c�c"
		}
		WaitPrompt()
		WaitCloseWindow()
	}
	//	WK_MAPRATIO - �n�}�̓��j���i1000��100%�j
	SetFlag( GF_QS_EVENT_TMP, 0 )	//1:�C�x���g�����i�I�����𔲂���j

	//�񍐏o���邩�̃`�F�b�N	//if������������ƃG���[���o�Ă��܂��̂ŁA�������Ă���܂�
	SetFlag(TF_MENU_SELECT,0)
	if( ( WORK[WK_MAPRATIO] < 200  && FLAG[GF_SPEEDRUN_MAP_10P] )||	// 10%�`20�������łP�O���A�C�e�������Ă���
		( WORK[WK_MAPRATIO] < 300  && FLAG[GF_SPEEDRUN_MAP_20P] )||	// 20%�`30�������łQ�O���A�C�e�������Ă���
		( WORK[WK_MAPRATIO] < 400  && FLAG[GF_SPEEDRUN_MAP_30P] )||	// 30%�`40�������łR�O���A�C�e�������Ă���
		( WORK[WK_MAPRATIO] < 500  && FLAG[GF_SPEEDRUN_MAP_40P] ))	// 40%�`50�������łS�O���A�C�e�������Ă���
	{
		SetFlag(TF_MENU_SELECT,1)	//�񍐏o���Ȃ�
	}
	else if(( WORK[WK_MAPRATIO] < 600  && FLAG[GF_SPEEDRUN_MAP_50P] )||	// 50%�`60�������łT�O���A�C�e�������Ă���
			( WORK[WK_MAPRATIO] < 700  && FLAG[GF_SPEEDRUN_MAP_60P] )||	// 60%�`70�������łU�O���A�C�e�������Ă���
			( WORK[WK_MAPRATIO] < 800  && FLAG[GF_SPEEDRUN_MAP_70P] ) )	// 70%�`80�������łV�O���A�C�e�������Ă���
	{
		SetFlag(TF_MENU_SELECT,1)	//�񍐏o���Ȃ�
	}
	else if(( WORK[WK_MAPRATIO] < 900  && FLAG[GF_SPEEDRUN_MAP_80P] )||	// 80%�`90�������łW�O���A�C�e�������Ă���
			( WORK[WK_MAPRATIO] < 1000 && FLAG[GF_SPEEDRUN_MAP_90P] ))	// 90%�`100�������łX�O���A�C�e�������Ă���
	{
		SetFlag(TF_MENU_SELECT,1)	//�񍐏o���Ȃ�
	}

	//��������������������������������������������������
	//	�˕񍐂��o���Ȃ��ꍇ�i���j���P�O�������j
	if( WORK[WK_MAPRATIO] < 100 )	// 10������
	{
		//	  �@�o���o���X�D���Ɂu�c�v�G���[�V�����B
		EmotionEx("Barbaross", 0.00f, EMO_3DOT, 0, 5, 1, 1, 1.5f)	//�c
		Wait(60)

		PlayVoice(Y8V_3710,"Barbaross",100)	//���܂�i�W�͌����Ȃ��悤����

		TalkPopup("Barbaross",0,0,0,0,0)
		{
			"#000e#000m���܂�i�W�͌����Ȃ��悤���ȁB\p"
			"���������T����i�߂Ă���A"
			"���߂Č����Ă��ꂽ�܂��B"
		}
		WaitPrompt()
		WaitCloseWindow()
		
		//	  �@��b�I���B
	}
	//	�˕񍐂��o���Ȃ��ꍇ�i���j���P�O���ȏ�j
	else if( FLAG[TF_MENU_SELECT] == 1 )
	{
		//	  �@�o���o���X�D���Ɂu�c�v�G���[�V�����B
		EmotionEx("Barbaross", 0.00f, EMO_3DOT, 0, 5, 1, 1, 1.5f)	//�c
		Wait(60)

		PlayVoice(Y8V_3710,"Barbaross",100)	//���܂�i�W�͌����Ȃ��悤����

		TalkPopup("Barbaross",0,0,0,0,0)
		{
			"#000e#000m���܂�i�W�͌����Ȃ��悤���ȁB\p2"
			"���������T����i�߂Ă���A2"
			"���߂Č����Ă��ꂽ�܂��B2"
		}
