		}
	}

////////////////////////////////////////////////////
// �L���S�[���F���C���C�x���g
//
////////////////////////////////////////////////////
// �L���S�[���F�T�u�C�x���g
//
	if( FLAG[GF_02MP1307_JOIN_KIERGAARD] 	//����� �J�[�����ƃL���S�[���ɏo�
		&& !FLAG[GF_HELP_B15]) {		// ���`���[�g���A���F��Ԉُ�
		EventCue("mp1201:SubEV_Help_Status_Irregular")
