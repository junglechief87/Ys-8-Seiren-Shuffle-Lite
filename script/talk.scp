			else if (FLAG[TF_MENU_SELECT] == 1)		// �V���b�v
			{
				// �V���b�v����
				ShopOpen( SHOP_ID_DRUG, -1 )		//�L���S�[���̐f�Ï�
			}
		}
		
		ResetStopFlag(STOPFLAG_TALK)
	}
////////////////////////////////////////////////////
// �L���S�[���F�ʏ��b
	else
	{
		// ��b����
		SetStopFlag(STOPFLAG_TALK)
		CallFunc("system:talk_begin_zoom")		//TALK_ZOOM
		CallFunc( "talk:Talk_Kiergaard2" )
