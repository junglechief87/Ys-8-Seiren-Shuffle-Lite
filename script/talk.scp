// ����b�J�g���[��
function "Talk_Katrin"
{
	//��b���[�v�����t���O�����낷�i���p�b�`1.01�Ή��j
	SetFlag( GF_QS_EVENT_TMP, 0 )				//1:�N�G�X�g�C�x���g����

	// ��b�������`�F�b�N
	SetFlag( TF_TALK_TYPE, 0 )
	if( FLAG[GF_NPC_2_08_JOIN_KATRIN])		//����񕔇G�J�g���[����������
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x01 ) )	// 0x01:�V���b�v����
	}
	if( ALLITEMWORK[ICON3D_PRESENT_KATRIN] &&	//�u��̔����߁v
	//	FLAG[GF_NPC_3_02_GOTO_GENSD] )			// �����^�C�~���O�F����O���A�W�����_�����Ɍ�����
		FLAG[GF_NPC_3_01_GOTO_LAXIA] )			// �����^�C�~���O�F����O���@���N�V���̌��֌�����
	{
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x02 ) )	// 0x02:�v���[���g�A�C�e������
	}
	if (FLAG[GF_QUEST_600] == QUEST_BBS || FLAG[GF_QUEST_600] == QUEST_START)	// �yQS600�z�P����Z�i�J�g���[���j �N�G�X�g�B�����s�O
	{
		// ����Z���A�W�����_��������֌�����
		//if (FLAG[GF_NPC_6_02_GOTO_GEND])	
		if (FLAG[GF_NPC_6_03_OCCUR_INTERCEPT12])
		{
			// ����Z���e�}����K�������i�Z�����̉�������j
			SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x10 ) )	// 0x10:�N�G�X�g�p�I��������P
		}
	}
	if(( FLAG[GF_QUEST_600] == QUEST_BBS || FLAG[GF_QUEST_600] == QUEST_START ) &&
		ALLITEMWORK[ICON3D_MT_R5_STONE] >= 1)	// �yQS600�z�P����Z�i�J�g���[���j �u�q�C���J�l�v�~�P�������Ă���	
	{
		//�@�w�q�C���J�l�x��n��	���u���N�G�X�g�B���C�x���g�v�ɐڑ�		���f�����m�F�A���f�ނ������Ă���Əo��
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x20 ) )	// 0x20:�N�G�X�g�p�I��������Q
	}
	if(!( FLAG[GF_NPC_5_06_HOLD_PARTY] && !FLAG[GF_NPC_5_07_GOTO_VALLAY] )&&	//�I����ܕ��E���̕Y�������U��i��j
		( !FLAG[GF_NPC_7_01_GOTO_TEM] )&&										//�I���G�s���[�O�@���@�O�֌�����
		( ALLITEMWORK[ICON3D_FIRESTONE] > 0 ) )		//	�R��
	{
		// ��荞�݃��b�Z�[�W�i�R�Γn���^�J�g���[���j
		SetFlag( TF_TALK_TYPE, ( FLAG[TF_TALK_TYPE] + 0x100 ) )	// 0x100:�R�΂�n����
	}
	// temporarily add dana to the party if she hasn't joined yet but a form has to allow weapon upgrades for dana forms
	if (FLAG[SF_DANA2_JOINOK] || [SF_DANA3_JOINOK]){
		SetFlag(SF_DANA_JOINOK,1)
	}

	// if dana forms are able to join temporarily disable so the weapon shop functions properly, we restore at the end of the talk_katrin script
	if (FLAG[SF_DANA2_JOINOK]){
		SetFlag(SF_DANA2_JOINOK,0)
		SetFlag(SF_DANA2_JOINOKBK,1)
		SetFlag(GF_TBOX_DUMMY102,1)
	}
	if (FLAG[SF_DANA3_JOINOK]){
		SetFlag(SF_DANA3_JOINOK,0)
		SetFlag(SF_DANA3_JOINOKBK,1)
		SetFlag(GF_TBOX_DUMMY103,1)
	}
	//new handler for lower tier weapons for characters that didn't have them in the original game
	if ((!ALLITEMWORK[ICON3D_987] || !ALLITEMWORK[ICON3D_991] || !ALLITEMWORK[ICON3D_WP_HUMMEL_000]) && FLAG[GF_02MP1201_JOIN_KATRIN] && !FLAG[SF_DEFEAT_ANCIENT])
	{
		SetStopFlag(STOPFLAG_TALK)
		TalkPopup("Katrin",0,0,0,0,0)
		{
			"#000e#000mI made you some new weapons\p"
			"Here have these on the house."
		}
		WaitPrompt()
		WaitCloseWindow()

		if(!ALLITEMWORK[ICON3D_987] && !ALLITEMWORK[ICON3D_WP_DANA_005])
		{
			GetItem(ICON3D_987, 2)
			EquipWeapon(DANA,ICON3D_987)
			GetItemMessageExPlus(ICON3D_987,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
			WaitPrompt()
			WaitCloseWindow()
		}
		if(!ALLITEMWORK[ICON3D_991])
		{
			GetItem(ICON3D_991, 2)
			EquipWeapon(RICOTTA,ICON3D_991)
			GetItemMessageExPlus(ICON3D_991,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
			WaitPrompt()
			WaitCloseWindow()
		}
		if(!ALLITEMWORK[ICON3D_WP_HUMMEL_000] && !ALLITEMWORK[ICON3D_WP_HUMMEL_100] && !ALLITEMWORK[ICON3D_WP_HUMMEL_200])
		{
			GetItem(ICON3D_WP_HUMMEL_000, 2)
			EquipWeapon(HUMMEL,ICON3D_WP_HUMMEL_000)
			GetItemMessageExPlus(ICON3D_WP_HUMMEL_000,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
			WaitPrompt()
			WaitCloseWindow()
		}
		ResetStopFlag(STOPFLAG_TALK)
	}
	if ((!ALLITEMWORK[ICON3D_988] || !ALLITEMWORK[ICON3D_WP_RICOTTA_000]) && FLAG[GF_TBOX_DUMMY081] && !FLAG[SF_DEFEAT_ANCIENT])
	{
		SetStopFlag(STOPFLAG_TALK)
		TalkPopup("Katrin",0,0,0,0,0)
		{
			"#000e#000mI made you some new weapons\p"
			"Here have these on the house."
		}
		WaitPrompt()
		WaitCloseWindow()
		
		if(!ALLITEMWORK[ICON3D_988] && !ALLITEMWORK[ICON3D_WP_DANA_005])
		{
			GetItem(ICON3D_988, 2)
			EquipWeapon(DANA,ICON3D_988)
			GetItemMessageExPlus(ICON3D_988,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
			WaitPrompt()
			WaitCloseWindow()
		}
		if(!ALLITEMWORK[ICON3D_WP_RICOTTA_000] && !ALLITEMWORK[ICON3D_WP_RICOTTA_100] && !ALLITEMWORK[ICON3D_WP_RICOTTA_200])
		{
			GetItem(ICON3D_WP_RICOTTA_000, 2)
			EquipWeapon(RICOTTA,ICON3D_WP_RICOTTA_000)
			GetItemMessageExPlus(ICON3D_WP_RICOTTA_000,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
			WaitPrompt()
			WaitCloseWindow()
		}
		ResetStopFlag(STOPFLAG_TALK)
	}

	if (!ALLITEMWORK[ICON3D_WP_DANA_000] && !ALLITEMWORK[ICON3D_WP_DANA_100] && !ALLITEMWORK[ICON3D_WP_DANA_200] && FLAG[GF_TBOX_DUMMY083] && !ALLITEMWORK[ICON3D_WP_DANA_005])
	{
		SetStopFlag(STOPFLAG_TALK)
		TalkPopup("Katrin",0,0,0,0,0)
		{
			"#000e#000mI made you some new weapons\p"
			"Here have these on the house."
		}
		WaitPrompt()
		WaitCloseWindow()

		GetItem(ICON3D_WP_DANA_000, 2)
		EquipWeapon(DANA,ICON3D_WP_DANA_000)
		GetItemMessageExPlus(ICON3D_WP_DANA_000,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
		WaitPrompt()
		WaitCloseWindow()
		ResetStopFlag(STOPFLAG_TALK)
	}
	if (!ALLITEMWORK[ICON3D_WP_DANA_001] && !ALLITEMWORK[ICON3D_WP_DANA_101] && !ALLITEMWORK[ICON3D_WP_DANA_201] && FLAG[GF_TBOX_DUMMY129] && FLAG[GF_TBOX_DUMMY084] && !ALLITEMWORK[ICON3D_WP_DANA_005] && !ALLITEMWORK[ICON3D_WP_DANA_001])
	{
		SetStopFlag(STOPFLAG_TALK)
		TalkPopup("Katrin",0,0,0,0,0)
		{
			"#000e#000mI made you some new weapons\p"
			"Here have these on the house."
		}
		WaitPrompt()
		WaitCloseWindow()

		GetItem(ICON3D_WP_DANA_001, 2)
		EquipWeapon(DANA,ICON3D_WP_DANA_001)
		GetItemMessageExPlus(ICON3D_WP_DANA_001,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
		WaitPrompt()
		WaitCloseWindow()
		ResetStopFlag(STOPFLAG_TALK)
	}
	if (!ALLITEMWORK[ICON3D_WP_DANA_002] && !ALLITEMWORK[ICON3D_WP_DANA_102] && !ALLITEMWORK[ICON3D_WP_DANA_202] && FLAG[GF_TBOX_DUMMY129] && FLAG[GF_TBOX_DUMMY085] && !ALLITEMWORK[ICON3D_WP_DANA_005] && !ALLITEMWORK[ICON3D_WP_DANA_002])
	{
		SetStopFlag(STOPFLAG_TALK)
		TalkPopup("Katrin",0,0,0,0,0)
		{
			"#000e#000mI made you some new weapons\p"
			"Here have these on the house."
		}
		WaitPrompt()
		WaitCloseWindow()

		GetItem(ICON3D_WP_DANA_002, 2)
		EquipWeapon(DANA,ICON3D_WP_DANA_002)
		GetItemMessageExPlus(ICON3D_WP_DANA_002,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
		WaitPrompt()
		WaitCloseWindow()
		ResetStopFlag(STOPFLAG_TALK)
	}
	if (!ALLITEMWORK[ICON3D_WP_DANA_003] && !ALLITEMWORK[ICON3D_WP_DANA_103] && !ALLITEMWORK[ICON3D_WP_DANA_203] && FLAG[GF_TBOX_DUMMY129] && FLAG[GF_TBOX_DUMMY086] && !ALLITEMWORK[ICON3D_WP_DANA_005] && !ALLITEMWORK[ICON3D_WP_DANA_003])
	{
		SetStopFlag(STOPFLAG_TALK)
		TalkPopup("Katrin",0,0,0,0,0)
		{
			"#000e#000mI made you some new weapons\p"
			"Here have these on the house."
		}
		WaitPrompt()
		WaitCloseWindow()

		GetItem(ICON3D_WP_DANA_003, 2)
		EquipWeapon(DANA,ICON3D_WP_DANA_003)
		GetItemMessageExPlus(ICON3D_WP_DANA_003,1,ITEMMSG_SE_NORMAL," obtained.",0,0)
		WaitPrompt()
		WaitCloseWindow()
		ResetStopFlag(STOPFLAG_TALK)
	}
	if (FLAG[GF_TBOX_DUMMY071] && FLAG[GF_TBOX_DUMMY109] && FLAG[GF_TBOX_DUMMY086] && ALLITEMWORK[ICON3D_WP_ADOL_008] < 1 && ALLITEMWORK[ICON3D_FIRESTONE] == 0) //If mistilteinn, progressive super items, and final forge level
	{
		SetStopFlag(STOPFLAG_SIMPLEEVENT2)
		SetFlag( TF_MENU_SELECT, 0 )
		YesNoMenu(TF_MENU_SELECT,"#7CFix the broken Mistilteinn?",1)
		
		//��������������������������������������������
		//�@�ˎx���v�����o��
		if( FLAG[TF_MENU_SELECT] )
		{
			SetEnvSEPlayState(-1, 0)
			FadeOut(FADE_BLACK,FADE_NORMAL)
			WaitFade()
			
			SetFlag( TF_MENU_SELECT, 1 )	
		}
		//	�˂�߂�
		else
		{
			
			SetFlag( TF_MENU_SELECT, 0 )
		}
		//��������������������������������������������

		if( FLAG[TF_MENU_SELECT] == 0 )
		{
			CrossFade(FADE_CROSS)
			SetStopFlag(STOPFLAG_NOCHARACLIP)
			
			ResetPartyPos()
			ResetFollowPoint()
			
			RestoreCamera(0,0)
			ResetCameraObserver(0)
			ResetCameraZPlane()
			Wait(FADE_CROSS)
			
			ResetStopFlag(STOPFLAG_SIMPLEEVENT2)
		}
		else
		{
			SetFlag(GF_ADOLWEAPON_BACKUP,(ADOL.CHRWORK[CWK_WEAPON]))
			EquipWeapon(ADOL,ICON3D_WP_ADOL_008)
			GetItem(ICON3D_WP_ADOL_008,1)
			DeleteItem(ICON3D_146,1)
			FadeIn(FADE_BLACK,FADE_NORMAL)
			WaitFade()
			ResetStopFlag(STOPFLAG_SIMPLEEVENT2)
		}
	}
	if (FLAG[GF_TBOX_DUMMY108] && FLAG[GF_TBOX_DUMMY109] && FLAG[GF_TBOX_DUMMY086] && ALLITEMWORK[ICON3D_WP_DANA_005] < 1 && ALLITEMWORK[ICON3D_FIRESTONE] == 0) //If spirit ring, progressive super items, and final forge level
	{
		SetStopFlag(STOPFLAG_SIMPLEEVENT2)
		SetFlag( TF_MENU_SELECT, 0 )
		YesNoMenu(TF_MENU_SELECT,"#7CFix the broken Spirit Ring?",1)
		
		//��������������������������������������������
		//�@�ˎx���v�����o��
		if( FLAG[TF_MENU_SELECT] )
		{
			SetEnvSEPlayState(-1, 0)
			FadeOut(FADE_BLACK,FADE_NORMAL)
			WaitFade()
			
			SetFlag( TF_MENU_SELECT, 1 )	
		}
		//	�˂�߂�
		else
		{
			
			SetFlag( TF_MENU_SELECT, 0 )
		}
		//��������������������������������������������

		if( FLAG[TF_MENU_SELECT] == 0 )
		{
			CrossFade(FADE_CROSS)
			SetStopFlag(STOPFLAG_NOCHARACLIP)
			
			ResetPartyPos()
			ResetFollowPoint()
			
			RestoreCamera(0,0)
			ResetCameraObserver(0)
			ResetCameraZPlane()
			Wait(FADE_CROSS)
			
			ResetStopFlag(STOPFLAG_SIMPLEEVENT2)
		}
		else
		{
			EquipWeapon(DANA,ICON3D_WP_DANA_005)
			GetItem(ICON3D_WP_DANA_005,1)
			DeleteItem(ICON3D_147,1)
			FadeIn(FADE_BLACK,FADE_NORMAL)
			WaitFade()
			ResetStopFlag(STOPFLAG_SIMPLEEVENT2)

		}		
	}
