function "Talk_Speedrun_Rex"
{
	//	------------------------------------------------------------
	//���n�V�r���R�E�ėp�����E������S�ēn���O
	if( !FLAG[GF_SPEEDRUN_FISH_24OVER]		// ��荞�݋��n���F�Q�S��ޓn����
		|| !FLAG[GF_SPEEDRUN_FISH_PRESENT24] || !FLAG[GF_SPEEDRUN_FISH_PRESENT25]
		|| !FLAG[GF_SPEEDRUN_FISH_PRESENT26] || !FLAG[GF_SPEEDRUN_FISH_PRESENT27] )
	{
		//������������������������������
		//	�ꏊ		�F�O��E���̑�
		//������������������������������
		//	�z�u�E�J�����F�n�V�r���R�E��{�`
		//	���[�V����	�F
		//������������������������������
		//�@�@�u����񕔇C�A���X�����������v�ȍ~�A�Y�����ɔz�u�B
		//�@�@������̃t���O���̂ݐ�p�����ƂȂ邪�A
		//�@�@�@����ȊO�̃^�C�~���O�͂��̔ėp�����ɗ����B

		TalkPopup("Rex",0,1,240,200,0)
		{
			"#000e#000m�c�c�c�c�c�c�c�c�c�c"
		}
		WaitPrompt()
		WaitCloseWindow()
	
		//	�i���[�V����
		TalkPopup(UNDEF,0,3,STOPPER_PPOSX,STOPPER_PPOSY,0)
		{
			"#7C�n�V�r���R�E�́A"
			"#7C�����Ƃ���������߂Ă���B"
		}
		WaitPrompt()
		WaitCloseWindow()

		if(ALLITEMWORK[ICON3D_FISHINGROD])
		{
			CallFunc("rng:fishRewardPreview")
		}

		SetFlag(TF_MENU_SELECT, 0)
		while (FLAG[TF_MENU_SELECT] != -1)	//���[�v�I����
		{
			CallFunc("talk:Menu_Rex")
		}
	}
	//	------------------------------------------------------------
	//���n�V�r���R�E�ėp�����E������S�ēn������
	else
	{
		TalkPopup("Rex", 0, 1, 240, 200, 0)
		{
			"#000e#000m�c�c�O�@�c�c�O�@�c�c�c�c"
		}
		WaitPrompt()
		WaitCloseWindow()
	
		//	�i���[�V����
		TalkPopup(UNDEF, 0, 3, SYSTEM_PPOSX, SYSTEM_PPOSY, 0)
		{
			"#7C�n�V�r���R�E�͖����C���B"
		}
		WaitPrompt()
		WaitCloseWindow()
	}
	//	------------------------------------------------------------
}
function "Menu_Rex"		//���[�v�I����
{
	//�I����
	SetFlag(TF_MENU_SELECT,0)
	MenuReset()
	MenuType(MENUTYPE_POPUP)

	if (GOTITEMWORK[ICON3D_FISH00] || FLAG[GF_SPEEDRUN_FISH_PRESENT00])		// �T�f�B�[�i
	{
		MenuAdd(1,"#282I�T�f�B�[�i��n���@�@�@�@")			//���A�C�e�������Ă���ƑI�����ɏo���A���ɓn���Ă���ƍ������ŏo��
		if( FLAG[GF_SPEEDRUN_FISH_PRESENT00] || !ALLITEMWORK[ICON3D_FISH00])	// ��荞�݋��n���F�T�f�B�[�i��n����
		{
			MenuEnable(1, 0)	//���łɓn���������Â����Ƃ��đI��s��
		}
	}
